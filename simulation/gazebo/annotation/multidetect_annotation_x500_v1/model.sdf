<?xml version="1.0"?>
<sdf version="1.9">
  <!--
    Capture-only wrapper. It keeps the production x500_mono_cam composition
    unchanged and adds sensors on a co-located, effectively massless link.
    The RGB/depth/telemetry runtime never subscribes to these topics.
  -->
  <model name="multidetect_annotation_x500_v1">
    <include merge="true">
      <uri>model://x500_mono_cam</uri>
    </include>

    <link name="annotation_camera_link">
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.000001</mass>
        <inertia>
          <ixx>0.000000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000000001</iyy>
          <iyz>0</iyz>
          <izz>0.000000001</izz>
        </inertia>
      </inertial>

      <!-- Ground-truth-like labels are available only to the offline capture
           collector. The policy adapter does not subscribe to this topic. -->
      <sensor name="annotation_boundingbox_camera" type="boundingbox_camera">
        <topic>multidetect/annotation/bounding_boxes_3d</topic>
        <camera>
          <box_type>3d</box_type>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <width>1280</width>
            <height>960</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>

      <sensor name="annotation_segmentation_camera" type="segmentation">
        <topic>multidetect/annotation/instance_segmentation</topic>
        <camera>
          <segmentation_type>instance</segmentation_type>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <width>1280</width>
            <height>960</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>
      <gravity>false</gravity>
      <velocity_decay />
    </link>

    <joint name="AnnotationCameraJoint" type="fixed">
      <parent>camera_link</parent>
      <child>annotation_camera_link</child>
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
    </joint>
  </model>
</sdf>
