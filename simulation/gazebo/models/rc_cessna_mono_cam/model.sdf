<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!--
    Repository-owned composition for the PX4 Gazebo fixed-wing path.

    PX4-gazebo-models supplies the aerodynamic rc_cessna body and the
    repository's existing mono_cam model supplies the camera sensor.  Keeping
    this as a composition preserves the upstream actuator/sensor contracts
    while giving Multi-Detect a stable model name and camera pose.
  -->
  <model name="rc_cessna_mono_cam">
    <include merge="true">
      <uri>model://rc_cessna</uri>
    </include>
    <include merge="true">
      <uri>model://mono_cam</uri>
      <!-- Forward-facing camera, slightly ahead and below the CG. -->
      <pose relative_to="base_link">0.48 0 -0.10 0 0 0</pose>
    </include>
    <joint name="CameraJoint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
      <pose relative_to="base_link">0.48 0 -0.10 0 0 0</pose>
    </joint>
    <!--
      Co-located metric depth source.  Gazebo's camera frame looks along +X;
      consumers that use an optical +Z convention must apply that explicit
      frame transform before interpreting the R_FLOAT32 image.  This SDF does
      not assert whether a depth scalar is optical-axis or ray-slant distance;
      the transport contract must bind and normalize that semantics.
    -->
    <link name="depth_camera_link">
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
      <!-- Keep the transport-only sensor from changing the rc_cessna mass/inertia. -->
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.000001</mass>
        <inertia>
          <ixx>0.000000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000000001</iyy>
          <iyz>0</iyz>
          <izz>0.000000001</izz>
        </inertia>
      </inertial>
      <sensor name="depth_camera" type="depth_camera">
        <gz_frame_id>depth_camera_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <width>1280</width>
            <height>960</height>
            <format>R_FLOAT32</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
      </sensor>
      <gravity>false</gravity>
      <velocity_decay />
    </link>
    <joint name="DepthCameraJoint" type="fixed">
      <parent>camera_link</parent>
      <child>depth_camera_link</child>
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
    </joint>
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
