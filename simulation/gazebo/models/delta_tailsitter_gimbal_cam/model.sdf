<sdf version="1.9">
  <model name="delta_tailsitter_gimbal_cam">
    <include merge="true">
      <uri>model://delta_tailsitter</uri>
    </include>
    <link name="c11_mount_link">
      <pose relative_to="base_link">0.046 0 0.388 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.005</mass>
        <inertia>
          <ixx>1e-06</ixx>
          <iyy>1e-06</iyy>
          <izz>1e-06</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="c11_mount_mesh">
        <geometry>
          <mesh>
            <uri>model://delta_tailsitter/meshes/c11_fixed.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
        <pose>0 0 -0.0417 0 1.5707963267948966 0</pose>
      </visual>
    </link>
    <joint name="c11_mount_joint" type="fixed">
      <parent>base_link</parent>
      <child>c11_mount_link</child>
    </joint>
    <link name="c11_yaw_link">
      <pose relative_to="base_link">0.046 0 0.388 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.002</mass>
        <inertia>
          <ixx>1e-08</ixx>
          <iyy>1e-08</iyy>
          <izz>1e-08</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="c11_yaw_mesh">
        <geometry>
          <mesh>
            <uri>model://delta_tailsitter/meshes/c11_yaw.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
        <pose>0 0 -0.0417 0 1.5707963267948966 0</pose>
      </visual>
    </link>
    <link name="c11_roll_link">
      <pose relative_to="base_link">0.046 0 0.3375 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.002</mass>
        <inertia>
          <ixx>1e-08</ixx>
          <iyy>1e-08</iyy>
          <izz>1e-08</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="camera_link">
      <pose relative_to="base_link">0.046 0 0.3375 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.01</mass>
        <inertia>
          <ixx>2e-05</ixx>
          <iyy>2e-05</iyy>
          <izz>2e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="c11_ball_mesh">
        <geometry>
          <mesh>
            <uri>model://delta_tailsitter/meshes/c11_ball.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.12 0.12 0.12 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
        <pose>0 0 0.0088 0 1.5707963267948966 0</pose>
      </visual>
      <sensor name="camera" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0.033 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>True</visualize>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>1280</width>
            <height>960</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>15000</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="camera_imu" type="imu">
        <gz_frame_id>camera_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <pose>0 0 0 0 0 0</pose>
      </sensor>
    </link>
    <link name="depth_camera_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-08</ixx>
          <iyy>1e-08</iyy>
          <izz>1e-08</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
      <sensor name="depth_camera" type="depth_camera">
        <gz_frame_id>depth_camera_link</gz_frame_id>
        <pose>0.033 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>True</visualize>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <format>R_FLOAT32</format>
            <width>1280</width>
            <height>960</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>15000</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name="c11_yaw_joint" type="revolute">
      <parent>c11_mount_link</parent>
      <child>c11_yaw_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 -1</xyz>
        <initial_position>0.0</initial_position>
        <limit>
          <lower>-6.283185307179586</lower>
          <upper>6.283185307179586</upper>
          <effort>100</effort>
          <velocity>-1</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="c11_roll_joint" type="revolute">
      <parent>c11_yaw_link</parent>
      <child>c11_roll_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <initial_position>0.0</initial_position>
        <limit>
          <lower>-0.785398</lower>
          <upper>0.785398</upper>
          <effort>100</effort>
          <velocity>-1</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="c11_pitch_joint" type="revolute">
      <parent>c11_roll_link</parent>
      <child>camera_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 -1 0</xyz>
        <initial_position>0.0</initial_position>
        <limit>
          <lower>-2.35619</lower>
          <upper>0.7854</upper>
          <effort>100</effort>
          <velocity>-1</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>
    <joint name="DepthCameraJoint" type="fixed">
      <parent>camera_link</parent>
      <child>depth_camera_link</child>
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
    </joint>
    <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
      <joint_name>c11_roll_joint</joint_name>
      <sub_topic>command/gimbal_roll</sub_topic>
      <p_gain>0.8</p_gain>
      <i_gain>0.01245</i_gain>
      <d_gain>0.015</d_gain>
      <i_max>0</i_max>
      <i_min>0</i_min>
      <cmd_max>0.3</cmd_max>
      <cmd_min>-0.3</cmd_min>
    </plugin>
    <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
      <joint_name>c11_pitch_joint</joint_name>
      <sub_topic>command/gimbal_pitch</sub_topic>
      <p_gain>0.8</p_gain>
      <i_gain>0.01245</i_gain>
      <d_gain>0.015</d_gain>
      <i_max>0</i_max>
      <i_min>0</i_min>
      <cmd_max>0.3</cmd_max>
      <cmd_min>-0.3</cmd_min>
    </plugin>
    <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
      <joint_name>c11_yaw_joint</joint_name>
      <sub_topic>command/gimbal_yaw</sub_topic>
      <p_gain>0.3</p_gain>
      <i_gain>0.01245</i_gain>
      <d_gain>0.015</d_gain>
      <i_max>0</i_max>
      <i_min>0</i_min>
      <cmd_max>0.3</cmd_max>
      <cmd_min>-0.3</cmd_min>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <update_rate>100</update_rate>
      <joint_name>rotor_0_joint</joint_name>
      <joint_name>rotor_1_joint</joint_name>
      <joint_name>rotor_2_joint</joint_name>
      <joint_name>rotor_3_joint</joint_name>
      <joint_name>c11_yaw_joint</joint_name>
      <joint_name>c11_roll_joint</joint_name>
      <joint_name>c11_pitch_joint</joint_name>
    </plugin>
  </model>
</sdf>
