    <link name="depth_camera_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1e-12</mass>
        <inertia>
          <ixx>1e-12</ixx>
          <iyy>1e-12</iyy>
          <izz>1e-12</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
      <sensor name="depth_camera" type="depth_camera">
        <gz_frame_id>depth_camera_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>True</visualize>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <format>R_FLOAT32</format>
            <width>1280</width>
            <height>960</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>15000</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name="DepthCameraJoint" type="fixed">
      <parent>camera_link</parent>
      <child>depth_camera_link</child>
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
    </joint>
    <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
      <joint_name>c11_roll_joint</joint_name>
      <sub_topic>command/gimbal_roll</sub_topic>
      <p_gain>0.8</p_gain>
      <i_gain>0.01245</i_gain>
      <d_gain>0.015</d_gain>
      <i_max>0</i_max>
      <i_min>0</i_min>
      <cmd_max>0.3</cmd_max>
      <cmd_min>-0.3</cmd_min>
    </plugin>
    <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
      <joint_name>c11_pitch_joint</joint_name>
      <sub_topic>command/gimbal_pitch</sub_topic>
      <p_gain>0.8</p_gain>
      <i_gain>0.01245</i_gain>
      <d_gain>0.015</d_gain>
      <i_max>0</i_max>
      <i_min>0</i_min>
