        <pose>-0.0412 0 -0.08 0 0 3.141592653589793</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>True</visualize>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>1280</width>
            <height>960</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>15000</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name="c11_pitch_joint" type="revolute">
      <parent>c11_roll_link</parent>
