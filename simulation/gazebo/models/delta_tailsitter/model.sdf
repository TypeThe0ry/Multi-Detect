    <link name="c11_yaw_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1e-12</mass>
        <inertia>
          <ixx>1e-12</ixx>
          <iyy>1e-12</iyy>
          <izz>1e-12</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
