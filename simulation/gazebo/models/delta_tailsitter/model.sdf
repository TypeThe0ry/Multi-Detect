<sdf version="1.9">
  <model name="delta_tailsitter">
    <!--由 scripts/generate_delta_tailsitter_model.py 生成。来源：折叠尾座式三角翼设计计算报告，
    方案 E（壳体优化目标），未经实飞验证；STEP 外观由转换器按部件导出。
    CAD mm -> base_link m: (-(z+9), x, 646-y)/1000；原点为报告 CG。
    base_link 是 MC FLU；PX4 FRD=(x,-y,-z)，前飞时俯仰约 -90°。
    整机质量 2.929 kg、CG 原点惯量 diag(0.431,0.097,0.373)。
    C11 与电子设备质量已经计入整机，包装相机/云台质量由包装链节显式分配。-->
    <link name="base_link">
      <inertial>
        <pose>-9.58759252732e-05 -0 -0.00377581952767 0 0 0</pose>
        <mass>2.837</mass>
        <inertia>
          <ixx>0.401596289421</ixx>
          <iyy>0.091848111343</iyy>
          <izz>0.344810147922</izz>
          <ixy>0</ixy>
          <ixz>0.000331419022912</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <collision name="body_collision">
        <pose>-0.009 0 0.021 0 0 0</pose>
        <geometry>
          <box>
            <size>0.158 0.300 0.850</size>
          </box>
        </geometry>
      </collision>
      <collision name="foot_0_collision">
        <pose>0.141 -0.6 -0.397 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.012</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>100</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <collision name="foot_1_collision">
        <pose>-0.159 0.6 -0.397 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.012</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>100</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <collision name="foot_2_collision">
        <pose>0.141 0.6 -0.397 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.012</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>100</kd>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <collision name="foot_3_collision">
        <pose>-0.159 -0.6 -0.397 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.012</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
