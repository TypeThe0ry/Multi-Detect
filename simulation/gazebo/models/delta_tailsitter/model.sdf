      <area>0.052</area>
      <air_density>1.15</air_density>
      <cp>-0.084 0.4925 -0.1743740442</cp>
      <forward>0 0 1</forward>
      <upward>-0.819152044289 -0.573576436351 0</upward>
      <link_name>base_link</link_name>
      <radial_symmetry>false</radial_symmetry>
    </plugin>
    <!--零升力阻力：两个无升力、半面积的虚拟阻力面，a0=±0.5、cda=0.064；
      |α|<0.5 rad 时平均 CD=0.064*(|0.5+α|+|-0.5+α|)/2=0.032。
      放在 CG，不添加虚构配平力矩；大迎角/悬停平板风载未经标定。-->
    <plugin name="gz::sim::systems::LiftDrag" filename="gz-sim-lift-drag-system">
      <!--parasitic_drag_-1-->
      <a0>-0.5</a0>
      <cla>0</cla>
      <cda>0.064</cda>
      <cma>0</cma>
      <alpha_stall>1.5707963267948966</alpha_stall>
      <cla_stall>0</cla_stall>
      <cda_stall>0.064</cda_stall>
      <cma_stall>0</cma_stall>
      <area>0.3035</area>
      <air_density>1.15</air_density>
      <cp>0 0 0</cp>
      <forward>0 0 1</forward>
      <upward>-1 0 0</upward>
      <link_name>base_link</link_name>
      <radial_symmetry>false</radial_symmetry>
    </plugin>
