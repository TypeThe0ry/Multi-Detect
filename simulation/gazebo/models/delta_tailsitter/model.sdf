    </plugin>
    <plugin name="gz::sim::systems::JointPositionController" filename="gz-sim-joint-position-controller-system">
      <joint_name>c11_yaw_joint</joint_name>
      <sub_topic>command/gimbal_yaw</sub_topic>
      <p_gain>0.3</p_gain>
      <i_gain>0.01245</i_gain>
      <d_gain>0.015</d_gain>
      <i_max>0</i_max>
      <i_min>0</i_min>
      <cmd_max>0.3</cmd_max>
      <cmd_min>-0.3</cmd_min>
    </plugin>
    <include merge="true">
      <uri>model://airspeed</uri>
      <pose relative_to="base_link">0 0 0.1 0 -1.5707963267948966 0</pose>
    </include>
    <joint name="airspeed_joint" type="fixed">
      <parent>base_link</parent>
      <child>airspeed_link</child>
    </joint>
    <!--设计报告方案 E：S=0.607，中央 0.399，外翼 4×0.052 m²；反角 ±35°。
      CLA=3.17830495，使中央+外翼投影后的整体 CLα=2.82/rad。
      CP：中央 CAD y=612；外翼反解到整体 NP y=666。CG y=646，SM=(666-646)/569=3.51%。
      ρ=1.15，AR=1.25²/0.607=2.57414，e=0.8；k=0.154571。
      15 m/s 配平 α=0.129704，诱导阻力 cda=0.169966。
      CLmax 取 0.8：整体失速 α=0.8/2.82；失速后斜率暂取 -1/rad。
      Cm0/cma=0：没有报告可验证的反弯力矩，静稳定仅来自 CP。-->
    <plugin name="gz::sim::systems::LiftDrag" filename="gz-sim-lift-drag-system">
      <!--central_wing-->
      <a0>0</a0>
      <cla>3.1783049526713416</cla>
      <cda>0.16996622352671675</cda>
      <cma>0</cma>
      <alpha_stall>0.28368794326241137</alpha_stall>
      <cla_stall>-1</cla_stall>
      <cda_stall>1</cda_stall>
      <cma_stall>0</cma_stall>
      <area>0.399</area>
      <air_density>1.15</air_density>
      <cp>-0.009 0 0.034</cp>
      <forward>0 0 1</forward>
      <upward>-1 0 0</upward>
      <link_name>base_link</link_name>
      <radial_symmetry>false</radial_symmetry>
    </plugin>
    <plugin name="gz::sim::systems::LiftDrag" filename="gz-sim-lift-drag-system">
      <!--outer_wing_-1_-1-->
      <a0>0</a0>
      <cla>3.1783049526713416</cla>
      <cda>0.16996622352671675</cda>
      <cma>0</cma>
      <alpha_stall>0.2344336645859731</alpha_stall>
      <cla_stall>-1</cla_stall>
      <cda_stall>1</cda_stall>
      <cma_stall>0</cma_stall>
      <area>0.052</area>
      <air_density>1.15</air_density>
      <cp>0.066 -0.4925 -0.1743740442</cp>
      <forward>0 0 1</forward>
      <upward>-0.819152044289 -0.573576436351 0</upward>
      <link_name>base_link</link_name>
      <radial_symmetry>false</radial_symmetry>
    </plugin>
    <plugin name="gz::sim::systems::LiftDrag" filename="gz-sim-lift-drag-system">
      <!--outer_wing_-1_1-->
      <a0>0</a0>
