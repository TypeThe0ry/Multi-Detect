      <child>c11_yaw_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <initial_position>0.0</initial_position>
        <limit>
          <lower>-6.283185307179586</lower>
          <upper>6.283185307179586</upper>
          <effort>100</effort>
