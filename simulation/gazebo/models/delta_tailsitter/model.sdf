    <link name="c11_mount_link">
      <pose relative_to="base_link">0.046 0 0.388 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>4e-06</mass>
        <inertia>
          <ixx>1e-09</ixx>
