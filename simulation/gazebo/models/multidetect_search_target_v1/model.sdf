<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!--
    Repository-owned neutral 3-D target for OnboardAI sensor capture.

    This is deliberately a solid, multi-part object rather than a flat image:
    chassis, cabin, wheels and a mast produce perspective, occlusion and
    metric depth cues.  No color, model name or pose is a runtime label.  The
    offline annotation path may inspect the scene, while the running policy
    only receives RGB/Depth/telemetry from the mounted vehicle sensors.
  -->
  <model name="multidetect_search_target_v1">
    <static>true</static>

    <link name="chassis_link">
      <pose>0 0 0.55 0 0 0</pose>
      <collision name="chassis_collision">
        <geometry><box><size>2.8 1.6 0.7</size></box></geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry><box><size>2.8 1.6 0.7</size></box></geometry>
        <material>
          <ambient>0.26 0.29 0.32 1</ambient>
          <diffuse>0.38 0.42 0.46 1</diffuse>
          <specular>0.16 0.18 0.20 1</specular>
        </material>
      </visual>
    </link>

    <link name="cabin_link">
      <pose>0.18 0 1.14 0 0 0</pose>
      <collision name="cabin_collision">
        <geometry><box><size>1.55 1.22 0.72</size></box></geometry>
      </collision>
      <visual name="cabin_visual">
        <geometry><box><size>1.55 1.22 0.72</size></box></geometry>
        <material>
          <ambient>0.46 0.49 0.52 1</ambient>
          <diffuse>0.62 0.66 0.70 1</diffuse>
          <specular>0.24 0.26 0.28 1</specular>
        </material>
      </visual>
      <visual name="cabin_window_front">
        <pose>0.79 0 0.05 0 0 0</pose>
        <geometry><box><size>0.025 0.86 0.34</size></box></geometry>
        <material>
          <ambient>0.10 0.16 0.20 1</ambient>
          <diffuse>0.18 0.28 0.34 1</diffuse>
          <specular>0.60 0.68 0.72 1</specular>
        </material>
      </visual>
      <visual name="cabin_window_side">
        <pose>0 0.62 0.05 0 0 0</pose>
        <geometry><box><size>0.82 0.025 0.34</size></box></geometry>
        <material>
          <ambient>0.10 0.16 0.20 1</ambient>
          <diffuse>0.18 0.28 0.34 1</diffuse>
          <specular>0.60 0.68 0.72 1</specular>
        </material>
      </visual>
    </link>

    <link name="sensor_mast_link">
      <pose>-0.62 0 1.92 0 0 0</pose>
      <collision name="mast_collision">
        <geometry><cylinder><radius>0.10</radius><length>1.05</length></cylinder></geometry>
      </collision>
      <visual name="mast_visual">
        <geometry><cylinder><radius>0.10</radius><length>1.05</length></cylinder></geometry>
        <material>
          <ambient>0.20 0.22 0.24 1</ambient>
          <diffuse>0.30 0.33 0.36 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="sensor_head_link">
      <pose>-0.62 0 2.50 0 0 0</pose>
      <collision name="sensor_head_collision">
        <geometry><box><size>0.58 0.46 0.32</size></box></geometry>
      </collision>
      <visual name="sensor_head_visual">
        <geometry><box><size>0.58 0.46 0.32</size></box></geometry>
        <material>
          <ambient>0.12 0.14 0.16 1</ambient>
          <diffuse>0.20 0.23 0.26 1</diffuse>
          <specular>0.36 0.40 0.44 1</specular>
        </material>
      </visual>
      <visual name="sensor_aperture">
        <pose>0.30 0 0 0 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.02</length></cylinder></geometry>
        <material>
          <ambient>0.04 0.05 0.06 1</ambient>
          <diffuse>0.07 0.08 0.09 1</diffuse>
          <specular>0.78 0.82 0.86 1</specular>
        </material>
      </visual>
    </link>

    <link name="wheel_left_front">
      <pose>0.88 0.82 0.35 0 1.5708 0</pose>
      <collision name="wheel_collision"><geometry><cylinder><radius>0.34</radius><length>0.20</length></cylinder></geometry></collision>
      <visual name="wheel_visual"><geometry><cylinder><radius>0.34</radius><length>0.20</length></cylinder></geometry><material><ambient>0.04 0.045 0.05 1</ambient><diffuse>0.07 0.08 0.09 1</diffuse></material></visual>
    </link>
    <link name="wheel_right_front">
      <pose>0.88 -0.82 0.35 0 1.5708 0</pose>
      <collision name="wheel_collision"><geometry><cylinder><radius>0.34</radius><length>0.20</length></cylinder></geometry></collision>
      <visual name="wheel_visual"><geometry><cylinder><radius>0.34</radius><length>0.20</length></cylinder></geometry><material><ambient>0.04 0.045 0.05 1</ambient><diffuse>0.07 0.08 0.09 1</diffuse></material></visual>
    </link>
    <link name="wheel_left_rear">
      <pose>-0.88 0.82 0.35 0 1.5708 0</pose>
      <collision name="wheel_collision"><geometry><cylinder><radius>0.34</radius><length>0.20</length></cylinder></geometry></collision>
      <visual name="wheel_visual"><geometry><cylinder><radius>0.34</radius><length>0.20</length></cylinder></geometry><material><ambient>0.04 0.045 0.05 1</ambient><diffuse>0.07 0.08 0.09 1</diffuse></material></visual>
    </link>
    <link name="wheel_right_rear">
      <pose>-0.88 -0.82 0.35 0 1.5708 0</pose>
      <collision name="wheel_collision"><geometry><cylinder><radius>0.34</radius><length>0.20</length></cylinder></geometry></collision>
      <visual name="wheel_visual"><geometry><cylinder><radius>0.34</radius><length>0.20</length></cylinder></geometry><material><ambient>0.04 0.045 0.05 1</ambient><diffuse>0.07 0.08 0.09 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
