<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.9">
  <model name="delta_tailsitter_mono_cam">
    <include merge="true">
      <uri>model://delta_tailsitter</uri>
    </include>
    <link name="segmentation_camera_link">
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
      <inertial>
        <mass>1e-12</mass>
        <inertia><ixx>1e-12</ixx><iyy>1e-12</iyy><izz>1e-12</izz></inertia>
      </inertial>
      <sensor name="segmentation_camera" type="segmentation">
        <gz_frame_id>segmentation_camera_link</gz_frame_id>
        <topic>/multidetect/teacher/segmentation</topic>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <segmentation_type>instance</segmentation_type>
          <horizontal_fov>2.0</horizontal_fov>
          <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>15000</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="SegmentationCameraJoint" type="fixed">
      <parent>camera_link</parent>
      <child>segmentation_camera_link</child>
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
    </joint>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
