<sdf version="1.9">
  <model name="delta_tailsitter_mono_cam">
    <include merge="true">
      <uri>model://delta_tailsitter</uri>
    </include>
    <link name="camera_link">
      <pose relative_to="base_link">0.046 0 0.388 0 -0.349065850399 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>3.999999e-06</mass>
        <inertia>
          <ixx>1e-09</ixx>
          <iyy>1e-09</iyy>
          <izz>1e-09</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="camera" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0 0 0 0 0 3.141592653589793</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>True</visualize>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>1280</width>
            <height>960</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>15000</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <link name="depth_camera_link">
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1e-12</mass>
        <inertia>
          <ixx>1e-12</ixx>
          <iyy>1e-12</iyy>
          <izz>1e-12</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="depth_camera" type="depth_camera">
        <gz_frame_id>depth_camera_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>True</visualize>
        <camera>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <format>R_FLOAT32</format>
            <width>1280</width>
            <height>960</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>15000</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <joint name="DepthCameraJoint" type="fixed">
      <parent>camera_link</parent>
      <child>depth_camera_link</child>
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
    </joint>
    <link name="segmentation_camera_link">
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1e-12</mass>
        <inertia>
          <ixx>1e-12</ixx>
          <iyy>1e-12</iyy>
          <izz>1e-12</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <sensor name="segmentation_camera" type="segmentation">
        <gz_frame_id>segmentation_camera_link</gz_frame_id>
        <topic>/multidetect/teacher/segmentation</topic>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <segmentation_type>instance</segmentation_type>
          <horizontal_fov>1.74</horizontal_fov>
          <image>
            <width>1280</width>
            <height>960</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>15000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>False</visualize>
      </sensor>
    </link>
    <joint name="SegmentationCameraJoint" type="fixed">
      <parent>camera_link</parent>
      <child>segmentation_camera_link</child>
      <pose relative_to="camera_link">0 0 0 0 0 0</pose>
    </joint>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
