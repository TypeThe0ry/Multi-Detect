<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!--
    Repository-owned non-flat terrain used to validate DEM ray intersection.
    Gazebo uses ENU (x=east, y=north, z=up).  The truth surface is a plane
    rolled by atan(0.1), so local elevation is exactly:

      z_msl = 25.0 + 0.1 * north_m

    The matching DEM is simulation/terrain/terrain_ranging_validation_001.dem.json.
    All scene geometry is local SDF; no Fuel or network asset is required.
  -->
  <world name="default">
    <physics name="px4_ode" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>false</grid>
      <ambient>0.40 0.43 0.46 1</ambient>
      <background>0.60 0.76 0.91 1</background>
      <shadows>true</shadows>
    </scene>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>1.300000</latitude_deg>
      <longitude_deg>103.800500</longitude_deg>
      <elevation>25.0</elevation>
    </spherical_coordinates>

    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.05</intensity>
      <direction>-0.25 0.35 -0.902</direction>
      <diffuse>0.96 0.94 0.88 1</diffuse>
      <specular>0.25 0.25 0.22 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <!-- atan(0.1) rad: north slope +0.1 m/m, east slope 0.0 m/m. -->
    <model name="multidetect_dem_truth_surface">
      <static>true</static>
      <pose>0 0 0 0.09966865249116204 0 0</pose>
      <link name="terrain_link">
        <collision name="terrain_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="terrain_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.22 0.40 0.16 1</ambient>
            <diffuse>0.30 0.55 0.22 1</diffuse>
            <specular>0.03 0.04 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- High-contrast primitives make the slope readable in a future visual run. -->
    <model name="north_slope_target">
      <static>true</static>
      <pose>70 80 9 0 0 0</pose>
      <link name="target_link">
        <collision name="target_collision">
          <geometry><box><size>4 4 2</size></box></geometry>
        </collision>
        <visual name="target_visual">
          <geometry><box><size>4 4 2</size></box></geometry>
          <material>
            <ambient>0.85 0.20 0.04 1</ambient>
            <diffuse>1.0 0.28 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="south_slope_target">
      <static>true</static>
      <pose>-100 -60 -5 0 0 0</pose>
      <link name="target_link">
        <collision name="target_collision">
          <geometry><cylinder><radius>2.5</radius><length>2</length></cylinder></geometry>
        </collision>
        <visual name="target_visual">
          <geometry><cylinder><radius>2.5</radius><length>2</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.28 0.85 1</ambient>
            <diffuse>0.08 0.38 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="home_marker">
      <static>true</static>
      <pose>0 0 0.03 0.09966865249116204 0 0</pose>
      <link name="marker_link">
        <visual name="marker_visual">
          <geometry><box><size>12 12 0.06</size></box></geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
