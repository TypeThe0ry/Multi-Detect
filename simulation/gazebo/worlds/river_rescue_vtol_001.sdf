<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!--
    Repository-owned river scene for the Multi-Detect SIM runtime.

    The world intentionally keeps the Gazebo entity name "default" so PX4,
    camera, NavSat, odometry, and QGC topic paths remain identical to the
    existing production-facing SIM bridge.  Every scene asset below is an SDF
    primitive; loading this file never requires Fuel or another network
    resource.
  -->
  <world name="default">
    <physics name="px4_ode" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <wind>
      <linear_velocity>3 -1.5 0</linear_velocity>
    </wind>

    <scene>
      <grid>false</grid>
      <ambient>0.42 0.45 0.48 1</ambient>
      <background>0.62 0.78 0.92 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- A fixed WGS84 home reference used by Gazebo NavSat. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>1.300000</latitude_deg>
      <longitude_deg>103.800500</longitude_deg>
      <elevation>5</elevation>
    </spherical_coordinates>

    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.05</intensity>
      <direction>-0.25 0.35 -0.902</direction>
      <diffuse>0.96 0.94 0.88 1</diffuse>
      <specular>0.25 0.25 0.22 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <!-- Broad collision plane: the VTOL starts on dry ground at (0, 0). -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>700 500</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>700 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.20 0.42 0.18 1</ambient>
            <diffuse>0.26 0.52 0.22 1</diffuse>
            <specular>0.03 0.04 0.03 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Three overlapping primitive reaches make a visible meandering river. -->
    <model name="river_surface">
      <static>true</static>
      <link name="west_reach">
        <pose>55 45 0.035 0 0 0.20</pose>
        <visual name="water_visual_west">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>125 22 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.03 0.28 0.43 0.92</ambient>
            <diffuse>0.05 0.43 0.65 0.92</diffuse>
            <specular>0.65 0.78 0.88 1</specular>
          </material>
          <transparency>0.08</transparency>
        </visual>
      </link>
      <link name="central_reach">
        <pose>160 58 0.035 0 0 -0.02</pose>
        <visual name="water_visual_central">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>100 24 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.03 0.28 0.43 0.92</ambient>
            <diffuse>0.05 0.43 0.65 0.92</diffuse>
            <specular>0.65 0.78 0.88 1</specular>
          </material>
          <transparency>0.08</transparency>
        </visual>
      </link>
      <link name="east_reach">
        <pose>250 38 0.035 0 0 -0.35</pose>
        <visual name="water_visual_east">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box>
              <size>110 21 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.03 0.28 0.43 0.92</ambient>
            <diffuse>0.05 0.43 0.65 0.92</diffuse>
            <specular>0.65 0.78 0.88 1</specular>
          </material>
          <transparency>0.08</transparency>
        </visual>
      </link>
    </model>

    <!-- Pale sand strips provide strong river-bank edges in the RGB stream. -->
    <model name="river_banks">
      <static>true</static>
      <link name="west_north_bank">
        <pose>52.2 58.7 0.055 0 0 0.20</pose>
        <visual name="visual">
          <geometry><box><size>125 4 0.08</size></box></geometry>
          <material>
            <ambient>0.52 0.43 0.25 1</ambient>
            <diffuse>0.72 0.62 0.38 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="west_south_bank">
        <pose>57.8 31.3 0.055 0 0 0.20</pose>
        <visual name="visual">
          <geometry><box><size>125 4 0.08</size></box></geometry>
          <material>
            <ambient>0.52 0.43 0.25 1</ambient>
            <diffuse>0.72 0.62 0.38 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="central_north_bank">
        <pose>160.3 73 0.055 0 0 -0.02</pose>
        <visual name="visual">
          <geometry><box><size>100 4 0.08</size></box></geometry>
          <material>
            <ambient>0.52 0.43 0.25 1</ambient>
            <diffuse>0.72 0.62 0.38 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="central_south_bank">
        <pose>159.7 43 0.055 0 0 -0.02</pose>
        <visual name="visual">
          <geometry><box><size>100 4 0.08</size></box></geometry>
          <material>
            <ambient>0.52 0.43 0.25 1</ambient>
            <diffuse>0.72 0.62 0.38 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="east_north_bank">
        <pose>255.1 52.1 0.055 0 0 -0.35</pose>
        <visual name="visual">
          <geometry><box><size>110 4 0.08</size></box></geometry>
          <material>
            <ambient>0.52 0.43 0.25 1</ambient>
            <diffuse>0.72 0.62 0.38 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="east_south_bank">
        <pose>244.9 23.9 0.055 0 0 -0.35</pose>
        <visual name="visual">
          <geometry><box><size>110 4 0.08</size></box></geometry>
          <material>
            <ambient>0.52 0.43 0.25 1</ambient>
            <diffuse>0.72 0.62 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Raised home pad keeps the default VTOL spawn visibly clear of water. -->
    <model name="vtol_home_pad">
      <static>true</static>
      <link name="pad_link">
        <collision name="pad_collision">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry><cylinder><radius>4.5</radius><length>0.05</length></cylinder></geometry>
        </collision>
        <visual name="pad_visual">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry><cylinder><radius>4.5</radius><length>0.05</length></cylinder></geometry>
          <material>
            <ambient>0.16 0.17 0.18 1</ambient>
            <diffuse>0.23 0.24 0.25 1</diffuse>
          </material>
        </visual>
        <visual name="h_vertical">
          <pose>0 0 0.056 0 0 0</pose>
          <geometry><box><size>0.65 4.4 0.015</size></box></geometry>
          <material><ambient>0.92 0.92 0.88 1</ambient><diffuse>1 1 0.96 1</diffuse></material>
        </visual>
        <visual name="h_left">
          <pose>-1.2 0 0.056 0 0 0</pose>
          <geometry><box><size>0.55 4.4 0.015</size></box></geometry>
          <material><ambient>0.92 0.92 0.88 1</ambient><diffuse>1 1 0.96 1</diffuse></material>
        </visual>
        <visual name="h_right">
          <pose>1.2 0 0.056 0 0 0</pose>
          <geometry><box><size>0.55 4.4 0.015</size></box></geometry>
          <material><ambient>0.92 0.92 0.88 1</ambient><diffuse>1 1 0.96 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- High-contrast, purely visual rescue object in the west river reach. -->
    <model name="rescue_marker_red">
      <static>true</static>
      <pose>76 49 0.12 0 0 0.20</pose>
      <link name="marker_link">
        <visual name="red_body">
          <pose>0 0 0.38 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.34</radius><length>1.35</length></cylinder></geometry>
          <material>
            <ambient>0.75 0.015 0.01 1</ambient>
            <diffuse>1.0 0.025 0.015 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <visual name="orange_float">
          <pose>0 0 0.44 0 0 0</pose>
          <geometry><sphere><radius>0.43</radius></sphere></geometry>
          <material>
            <ambient>0.95 0.20 0.01 1</ambient>
            <diffuse>1.0 0.38 0.015 1</diffuse>
          </material>
        </visual>
        <visual name="reflective_strip">
          <pose>0 0 0.52 0 0 0</pose>
          <geometry><box><size>1.45 0.09 0.12</size></box></geometry>
          <material>
            <ambient>0.96 0.96 0.80 1</ambient>
            <diffuse>1 1 0.86 1</diffuse>
            <emissive>0.25 0.25 0.16 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Two bank beacons make heading and scale legible to the same RGB path. -->
    <model name="shore_marker_alpha">
      <static>true</static>
      <pose>38 59 0 0 0 0</pose>
      <link name="beacon_link">
        <visual name="pole">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>3</length></cylinder></geometry>
          <material><ambient>0.85 0.72 0.02 1</ambient><diffuse>1 0.88 0.02 1</diffuse></material>
        </visual>
        <visual name="top">
          <pose>0 0 3.1 0 0 0</pose>
          <geometry><sphere><radius>0.32</radius></sphere></geometry>
          <material>
            <ambient>0.9 0.05 0.02 1</ambient>
            <diffuse>1 0.08 0.02 1</diffuse>
            <emissive>0.25 0.01 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <model name="shore_marker_bravo">
      <static>true</static>
      <pose>108 35 0 0 0 0</pose>
      <link name="beacon_link">
        <visual name="pole">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>3</length></cylinder></geometry>
          <material><ambient>0.85 0.72 0.02 1</ambient><diffuse>1 0.88 0.02 1</diffuse></material>
        </visual>
        <visual name="top">
          <pose>0 0 3.1 0 0 0</pose>
          <geometry><sphere><radius>0.32</radius></sphere></geometry>
          <material>
            <ambient>0.02 0.12 0.85 1</ambient>
            <diffuse>0.02 0.20 1 1</diffuse>
            <emissive>0.0 0.02 0.25 1</emissive>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
