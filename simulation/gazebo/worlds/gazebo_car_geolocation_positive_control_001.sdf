<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!--
    Repository-owned, software-only Gazebo geolocation control scene. Gazebo
    ENU uses +X east. The x500 starts on a collision-only elevated support,
    while the car billboard remains on the DEM ground eight metres east.

    The invisible support makes the initial pose deterministic without
    arming, commanding, or pretending that a static geometry test is flight.
    No detector answer, annotation, bounding box, or expected confidence is
    present in this runtime world. Independent truth is evaluator-only. This
    auxiliary scenario is not QGC-rendering, hardware, HIL, REAL, outdoor
    GNSS, flight, or production-model evidence.
  -->
  <world name="default">
    <physics name="px4_ode" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>false</grid>
      <ambient>0.58 0.58 0.58 1</ambient>
      <background>0.68 0.78 0.90 1</background>
      <shadows>false</shadows>
    </scene>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>1.300000</latitude_deg>
      <longitude_deg>103.800500</longitude_deg>
      <elevation>25.0</elevation>
    </spherical_coordinates>

    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1.15</intensity>
      <direction>-0.35 0.20 -0.915</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.18 0.18 0.18 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <model name="multidetect_dem_truth_surface">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="terrain_link">
        <collision name="terrain_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="terrain_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.38 0.45 0.32 1</ambient>
            <diffuse>0.48 0.58 0.40 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Collision-only static support: top face is z=5.5 m. -->
    <model name="multidetect_geolocation_vehicle_support">
      <static>true</static>
      <pose>0 0 5.4 0 0 0</pose>
      <link name="support_link">
        <collision name="support_collision">
          <geometry><box><size>2.5 2.5 0.2</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <model name="gazebo_car_geolocation_positive_control_billboard">
      <static>true</static>
      <pose>8 0 1.15 0 0 0</pose>
      <link name="billboard_link">
        <collision name="billboard_collision">
          <geometry><box><size>0.08 3.3 2.2</size></box></geometry>
        </collision>
        <visual name="car_positive_control_visual">
          <geometry>
            <mesh>
              <uri>model://multidetect_coco_car_billboard_v1/meshes/car_billboard.obj</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <double_sided>true</double_sided>
            <pbr>
              <metal>
                <albedo_map>model://multidetect_coco_car_billboard_v1/materials/textures/coco-car-positive-control-v1.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <model name="home_marker">
      <static>true</static>
      <pose>0 0 0.03 0 0 0</pose>
      <link name="marker_link">
        <visual name="marker_visual">
          <geometry><box><size>5 5 0.06</size></box></geometry>
          <material>
            <ambient>0.70 0.70 0.70 1</ambient>
            <diffuse>0.86 0.86 0.86 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
