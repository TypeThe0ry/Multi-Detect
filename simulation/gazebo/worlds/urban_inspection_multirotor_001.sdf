<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!--
    Repository-owned urban inspection scene for the Multi-Detect SIM
    multirotor runtime.  Geometry is made only from local SDF primitives so
    loading the world never requires Fuel or another network resource.
    The default world name keeps PX4/Gazebo/QGC topic paths identical across
    all three supported airframe classes.
  -->
  <world name="default">
    <physics name="px4_ode" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <wind>
      <linear_velocity>1.0 -0.4 0</linear_velocity>
    </wind>

    <scene>
      <grid>false</grid>
      <ambient>0.46 0.48 0.52 1</ambient>
      <background>0.56 0.74 0.88 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- WGS-84 reference shared with the deterministic fallback model. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>1.352100</latitude_deg>
      <longitude_deg>103.819800</longitude_deg>
      <elevation>18</elevation>
    </spherical_coordinates>

    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.10</intensity>
      <direction>-0.25 0.35 -0.902</direction>
      <diffuse>0.96 0.94 0.88 1</diffuse>
      <specular>0.25 0.25 0.22 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>700 700</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>700 700</size></plane>
          </geometry>
          <material>
            <ambient>0.22 0.38 0.20 1</ambient>
            <diffuse>0.28 0.50 0.24 1</diffuse>
            <specular>0.04 0.05 0.04 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Raised launch pad and a visible north arrow provide a stable spawn. -->
    <model name="multirotor_home_pad">
      <static>true</static>
      <link name="pad_link">
        <collision name="pad_collision">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry><cylinder><radius>5.0</radius><length>0.08</length></cylinder></geometry>
        </collision>
        <visual name="pad_visual">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry><cylinder><radius>5.0</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.14 0.16 0.18 1</ambient><diffuse>0.22 0.24 0.27 1</diffuse></material>
        </visual>
        <visual name="pad_h">
          <pose>0 0 0.092 0 0 0</pose>
          <geometry><box><size>3.0 0.35 0.015</size></box></geometry>
          <material><ambient>0.92 0.92 0.88 1</ambient><diffuse>1.0 1.0 0.96 1</diffuse></material>
        </visual>
        <visual name="pad_h_cross">
          <pose>0 0 0.092 0 0 1.5708</pose>
          <geometry><box><size>3.0 0.35 0.015</size></box></geometry>
          <material><ambient>0.92 0.92 0.88 1</ambient><diffuse>1.0 1.0 0.96 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Three low-rise blocks form a repeatable inspection corridor. -->
    <model name="inspection_block_alpha">
      <static>true</static><pose>70 35 7 0 0 0.12</pose>
      <link name="building_link">
        <collision name="building_collision"><geometry><box><size>38 28 14</size></box></geometry></collision>
        <visual name="building_visual"><geometry><box><size>38 28 14</size></box></geometry><material><ambient>0.42 0.45 0.50 1</ambient><diffuse>0.58 0.61 0.68 1</diffuse></material></visual>
        <visual name="roof"><pose>0 0 7.1 0 0 0</pose><geometry><box><size>40 30 0.25</size></box></geometry><material><ambient>0.12 0.14 0.17 1</ambient><diffuse>0.18 0.20 0.24 1</diffuse></material></visual>
      </link>
    </model>
    <model name="inspection_block_bravo">
      <static>true</static><pose>125 -42 10 0 0 -0.08</pose>
      <link name="building_link">
        <collision name="building_collision"><geometry><box><size>45 34 20</size></box></geometry></collision>
        <visual name="building_visual"><geometry><box><size>45 34 20</size></box></geometry><material><ambient>0.48 0.38 0.30 1</ambient><diffuse>0.67 0.50 0.38 1</diffuse></material></visual>
        <visual name="roof"><pose>0 0 10.1 0 0 0</pose><geometry><box><size>47 36 0.25</size></box></geometry><material><ambient>0.16 0.12 0.10 1</ambient><diffuse>0.25 0.18 0.15 1</diffuse></material></visual>
      </link>
    </model>
    <model name="inspection_block_charlie">
      <static>true</static><pose>215 28 6 0 0 0.25</pose>
      <link name="building_link">
        <collision name="building_collision"><geometry><box><size>32 26 12</size></box></geometry></collision>
        <visual name="building_visual"><geometry><box><size>32 26 12</size></box></geometry><material><ambient>0.34 0.43 0.38 1</ambient><diffuse>0.44 0.58 0.48 1</diffuse></material></visual>
        <visual name="roof"><pose>0 0 6.1 0 0 0</pose><geometry><box><size>34 28 0.25</size></box></geometry><material><ambient>0.10 0.16 0.12 1</ambient><diffuse>0.14 0.23 0.17 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Local roads and a bridge make camera motion and altitude observable. -->
    <model name="inspection_road">
      <static>true</static><pose>120 0 0.035 0 0 0</pose>
      <link name="road_link">
        <collision name="road_collision"><geometry><box><size>320 13 0.06</size></box></geometry></collision>
        <visual name="road_visual"><geometry><box><size>320 13 0.06</size></box></geometry><material><ambient>0.10 0.11 0.13 1</ambient><diffuse>0.16 0.17 0.19 1</diffuse></material></visual>
        <visual name="road_centerline"><pose>0 0 0.04 0 0 0</pose><geometry><box><size>310 0.20 0.012</size></box></geometry><material><ambient>0.88 0.82 0.52 1</ambient><diffuse>1.0 0.94 0.62 1</diffuse></material></visual>
      </link>
    </model>
    <model name="inspection_bridge">
      <static>true</static><pose>168 0 1.6 0 0 0</pose>
      <link name="bridge_link">
        <collision name="bridge_collision"><geometry><box><size>25 24 3.2</size></box></geometry></collision>
        <visual name="bridge_visual"><geometry><box><size>25 24 3.2</size></box></geometry><material><ambient>0.29 0.31 0.33 1</ambient><diffuse>0.40 0.42 0.45 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Coloured survey pylons are visible scene landmarks, not answer data. -->
    <model name="survey_marker_north">
      <static>true</static><pose>62 78 1.3 0 0 0</pose>
      <link name="marker_link">
        <visual name="body"><geometry><cylinder><radius>0.8</radius><length>2.6</length></cylinder></geometry><material><ambient>0.88 0.20 0.08 1</ambient><diffuse>1.0 0.28 0.10 1</diffuse></material></visual>
        <visual name="cap"><pose>0 0 1.5 0 0 0</pose><geometry><sphere><radius>1.0</radius></sphere></geometry><material><ambient>0.96 0.74 0.08 1</ambient><diffuse>1.0 0.86 0.12 1</diffuse></material></visual>
      </link>
    </model>
    <model name="survey_marker_east">
      <static>true</static><pose>245 -55 1.3 0 0 0</pose>
      <link name="marker_link">
        <visual name="body"><geometry><cylinder><radius>0.8</radius><length>2.6</length></cylinder></geometry><material><ambient>0.06 0.55 0.85 1</ambient><diffuse>0.08 0.70 1.0 1</diffuse></material></visual>
        <visual name="cap"><pose>0 0 1.5 0 0 0</pose><geometry><sphere><radius>1.0</radius></sphere></geometry><material><ambient>0.82 0.20 0.78 1</ambient><diffuse>1.0 0.30 0.90 1</diffuse></material></visual>
      </link>
    </model>

    <!-- A small tree line gives the camera depth and lateral features. -->
    <model name="inspection_tree_line">
      <static>true</static>
      <link name="trees_link">
        <visual name="trunk_a"><pose>32 95 2.5 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>5</length></cylinder></geometry><material><ambient>0.22 0.12 0.07 1</ambient><diffuse>0.32 0.18 0.10 1</diffuse></material></visual>
        <visual name="canopy_a"><pose>32 95 6 0 0 0</pose><geometry><sphere><radius>3.8</radius></sphere></geometry><material><ambient>0.10 0.34 0.14 1</ambient><diffuse>0.15 0.50 0.20 1</diffuse></material></visual>
        <visual name="trunk_b"><pose>32 120 2.5 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>5</length></cylinder></geometry><material><ambient>0.22 0.12 0.07 1</ambient><diffuse>0.32 0.18 0.10 1</diffuse></material></visual>
        <visual name="canopy_b"><pose>32 120 6 0 0 0</pose><geometry><sphere><radius>3.8</radius></sphere></geometry><material><ambient>0.10 0.34 0.14 1</ambient><diffuse>0.15 0.50 0.20 1</diffuse></material></visual>
        <visual name="trunk_c"><pose>32 145 2.5 0 0 0</pose><geometry><cylinder><radius>0.45</radius><length>5</length></cylinder></geometry><material><ambient>0.22 0.12 0.07 1</ambient><diffuse>0.32 0.18 0.10 1</diffuse></material></visual>
        <visual name="canopy_c"><pose>32 145 6 0 0 0</pose><geometry><sphere><radius>3.8</radius></sphere></geometry><material><ambient>0.10 0.34 0.14 1</ambient><diffuse>0.15 0.50 0.20 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Neutral structural target for RGB/Depth training; identity is not encoded in color. -->
    <include>
      <uri>model://multidetect_search_target_v1</uri>
      <name>multidetect_search_target_urban_001</name>
      <pose>180 -58 0 0 0 0.45</pose>
    </include>
  </world>
</sdf>
