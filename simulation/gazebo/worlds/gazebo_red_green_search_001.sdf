<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!--
    Repository-owned software-only red/green search scene.  The initial
    green billboard is intentionally visible from the takeoff corridor while
    the red billboard is north/east of it, outside the initial horizontal
    camera field of view but inside the first bounded search leg.  The onboard
    model must reject green, publish its bounded search Mission, turn toward
    the forward corridor, and then match the red target.  Runtime code receives
    only Gazebo RGB, depth,
    and telemetry; the target truth file is evaluator-only.

    This scene is external Gazebo software-SIM evidence only.  It does not
    claim Jetson, Pixhawk hardware, HIL, outdoor GNSS, or final release.
  -->
  <world name="default">
    <physics name="px4_ode" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.58 0.58 0.58 1</ambient>
      <background>0.68 0.78 0.90 1</background>
      <shadows>false</shadows>
    </scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>1.300000</latitude_deg>
      <longitude_deg>103.800500</longitude_deg>
      <elevation>25.0</elevation>
    </spherical_coordinates>
    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1.15</intensity>
      <direction>-0.35 0.20 -0.915</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.18 0.18 0.18 1</specular>
      <attenuation><range>2000</range><linear>0</linear><constant>1</constant><quadratic>0</quadratic></attenuation>
    </light>
    <model name="multidetect_dem_truth_surface">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="terrain_link">
        <collision name="terrain_collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="terrain_visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.38 0.45 0.32 1</ambient>
            <diffuse>0.48 0.58 0.40 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="gazebo_green_car_search_distractor_billboard">
      <static>true</static>
      <!-- The green distractor is centered in the initial +X camera view. -->
      <pose>20.0 0 1.15 0 0 0</pose>
      <link name="billboard_link">
        <collision name="billboard_collision">
          <geometry><box><size>0.08 3.3 2.2</size></box></geometry>
        </collision>
        <visual name="green_car_search_distractor_visual">
          <geometry>
            <mesh>
              <uri>model://multidetect_coco_car_billboard_v1/meshes/car_billboard.obj</uri>
            <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.015 0.80 0.025 1</ambient>
            <diffuse>0.015 0.80 0.025 1</diffuse>
            <specular>0.01 0.05 0.01 1</specular>
            <double_sided>true</double_sided>
            <pbr>
              <metal>
                <albedo_map>model://multidetect_coco_car_billboard_v1/materials/textures/coco-car-positive-control-v1.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="gazebo_red_car_search_target_billboard">
      <static>true</static>
      <!-- The measured r12 search output is about -51 m east / +25 m north.
           Put the red target on the forward side of the observed search turn:
           it is outside the initial east-facing camera view, then enters the
           approximately 40-degree forward corridor after the model rotates
           and moves the vehicle. -->
      <!-- Bearing is outside the initial camera view and enters after the
           first bounded search leg (world ENU: east=5 m, north=30 m).  The
           northward offset matches the model's green-mismatch search motion,
           so the red target is not visible until that replan executes. -->
      <pose>5.0 30.0 1.15 0 0 0</pose>
      <link name="billboard_link">
        <collision name="billboard_collision">
          <geometry><box><size>0.08 6.6 4.4</size></box></geometry>
        </collision>
        <visual name="red_car_search_target_visual">
          <geometry>
            <mesh>
              <uri>model://multidetect_coco_car_billboard_v1/meshes/car_billboard.obj</uri>
              <!-- The enlarged positive-control target stays outside the
                   initial view but remains confidently classifiable when the
                   bounded search turn brings its edge into frame. -->
              <scale>2 2 2</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>1.0 0.015 0.015 1</ambient>
            <diffuse>1.0 0.015 0.015 1</diffuse>
            <specular>0.05 0.01 0.01 1</specular>
            <double_sided>true</double_sided>
            <pbr>
              <metal>
                <albedo_map>model://multidetect_coco_car_billboard_v1/materials/textures/coco-car-positive-control-v1.png</albedo_map>
                <metalness>0.0</metalness>
                <roughness>1.0</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="home_marker">
      <static>true</static>
      <pose>0 0 0.03 0 0 0</pose>
      <link name="marker_link">
        <visual name="marker_visual">
          <geometry><box><size>5 5 0.06</size></box></geometry>
          <material><ambient>0.70 0.70 0.70 1</ambient><diffuse>0.86 0.86 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
