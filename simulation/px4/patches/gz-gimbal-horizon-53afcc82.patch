+using Setpoint = gimbal_device_set_attitude_s;
+constexpr auto RollLock = Setpoint::GIMBAL_DEVICE_FLAGS_ROLL_LOCK;
+constexpr auto PitchLock = Setpoint::GIMBAL_DEVICE_FLAGS_PITCH_LOCK;
+constexpr auto YawLock = Setpoint::GIMBAL_DEVICE_FLAGS_YAW_LOCK;
+constexpr auto YawVehicle = Setpoint::GIMBAL_DEVICE_FLAGS_YAW_IN_VEHICLE_FRAME;
+constexpr auto YawEarth = Setpoint::GIMBAL_DEVICE_FLAGS_YAW_IN_EARTH_FRAME;
+constexpr auto Neutral = Setpoint::GIMBAL_DEVICE_FLAGS_NEUTRAL;
+constexpr auto AllowedFlags = RollLock | PitchLock | YawLock | YawVehicle | YawEarth | Neutral;
+constexpr hrt_abstime PoseInterval = 20_ms;
+constexpr hrt_abstime RateMaxAge = 60_ms;
+constexpr float PreviewSeconds = 0.20f;
+constexpr float PreviewMaxAngle = 12.f * M_PI_F / 180.f;
+
+matrix::Dcmf previewBody(const matrix::Quatf &attitude, const vehicle_angular_velocity_s &rate, hrt_abstime now)
+{
+	const matrix::Vector3f omega(rate.xyz);
+	const float speed = omega.norm();
+
+	if (!rate.timestamp_sample || now < rate.timestamp_sample || now - rate.timestamp_sample > RateMaxAge
+	    || !PX4_ISFINITE(speed) || speed <= 1e-6f) {
+		return matrix::Dcmf(attitude);
+	}
+
+	// Right-compose the FRD body-rate delta. This stays continuous at vertical pitch.
+	const float half_angle = 0.5f * math::min(speed * PreviewSeconds, PreviewMaxAngle);
+	const float scale = sinf(half_angle) / speed;
+	const matrix::Quatf delta(cosf(half_angle), omega(0) * scale, omega(1) * scale, omega(2) * scale);
+	return matrix::Dcmf(attitude * delta);
+}
+
+bool earthYaw(uint16_t flags)
+{
+	return (flags & YawEarth) || (!(flags & YawVehicle) && (flags & YawLock));
+}
+
+float nearestTurn(float angle, float previous)
+{
+	return previous + remainderf(angle - previous, 2.f * M_PI_F);
+}
+
+// Nearest 2*pi-congruent winding of angle to previous that also lies inside [lo, hi].
+// The window is only enforced when it spans a full turn; otherwise this is nearestTurn().
+// Without it the nearest winding can fall outside a +-2*pi joint stop (previous at the
+// stop, target on the other side of the turn) and be clipped back to the stop forever.
+float nearestTurnWithin(float angle, float previous, float lo, float hi)
+{
+	float y = nearestTurn(angle, previous);
+
+	if (hi - lo >= 2.f * M_PI_F) {
+		while (y > hi) { y -= 2.f * M_PI_F; }
+
+		while (y < lo) { y += 2.f * M_PI_F; }
+	}
+
+	return y;
+}
+
+matrix::Dcmf zxy(float roll, float pitch, float yaw)
+{
+	return matrix::Dcmf(matrix::Eulerf(0.f, 0.f, yaw))
+	       * matrix::Dcmf(matrix::Eulerf(roll, 0.f, 0.f))
+	       * matrix::Dcmf(matrix::Eulerf(0.f, pitch, 0.f));
+}
+
+matrix::Vector3f boundedJoints(const matrix::Dcmf &relative, const matrix::Vector3f &previous,
+			      float roll_min, float roll_max, float pitch_min, float pitch_max,
+			      float yaw_min, float yaw_max, bool &exact_pose)
+{
+	const float roll = asinf(math::constrain(relative(2, 1), -1.f, 1.f));
+	const bool singular = fabsf(cosf(roll)) < 1e-6f;
+	const float yaw = singular ? previous(2) : atan2f(-relative(0, 1), relative(1, 1));
+	float pitch = atan2f(-relative(2, 0), relative(2, 2));
+
+	if (singular) {
+		const matrix::Dcmf residual(zxy(roll, 0.f, yaw).transpose() * relative);
+		pitch = atan2f(residual(0, 2), residual(0, 0));
+	}
+	// Match the host branch choice for C11: prefer an exact solution,
+	// then least travel through regions where both branches hit a stop.
+	matrix::Vector3f best{};
+	float best_travel = INFINITY;
+	bool best_exact = false;
+
+	for (int branch = 0; branch < 2; ++branch) {
+		const float r = nearestTurn(branch ? M_PI_F - roll : roll, previous(0));
+		const float branch_offset = branch ? M_PI_F : 0.f;
+		const float p = nearestTurn(pitch + branch_offset, previous(1));
+		const float y = nearestTurnWithin(yaw + branch_offset, previous(2), yaw_min, yaw_max);
+		const matrix::Vector3f bounded{math::constrain(r, roll_min, roll_max),
+					      math::constrain(p, pitch_min, pitch_max), y};
+		const bool exact = fabsf(bounded(0) - r) < 1e-6f && fabsf(bounded(1) - p) < 1e-6f;
+		const float travel = (bounded - previous).norm_squared();
+
+		if ((exact && !best_exact) || (exact == best_exact && travel < best_travel)) {
+			best = bounded;
+			best_exact = exact;
+			best_travel = travel;
+		}
+	}
+
+	exact_pose = best_exact;
+	return best;
+}
+
+bool horizonJoints(const matrix::Dcmf &body, const matrix::Dcmf &desired,
+		   const matrix::Vector3f &previous, float roll_min, float roll_max,
+		   float pitch_min, float pitch_max, float yaw_min, float yaw_max, matrix::Vector3f &joint)
+{
+	// As earth yaw varies, each entry of B^T Rz(yaw) D is
+	// a*cos(yaw) + b*sin(yaw) + c. Roll stops exclude the other
+	// branch. Cut the circle at the roll stops and pitch limit rays,
+	// then check endpoints and intervals as in the host horizon solver.
+	const auto entry = [&](std::size_t row, std::size_t col) {
+		return matrix::Vector3f(body(0, row) * desired(0, col) + body(1, row) * desired(1, col),
+				       body(1, row) * desired(0, col) - body(0, row) * desired(1, col),
+				       body(2, row) * desired(2, col));
+	};
+	const auto sr = entry(2, 1);
+	const matrix::Vector3f sp = -entry(2, 0);
+	const auto cp = entry(2, 2);
+	constexpr float turn = 2.f * M_PI_F;
+	constexpr unsigned max_cuts = 2 + 2 * 4; // endpoints plus two roots per limit
+	float cuts[max_cuts] {0.f, turn};
+	unsigned count = 2;
+	const auto roots = [&](const matrix::Vector3f &v, float value) {
+		const float amplitude = hypotf(v(0), v(1));
+
+		if (count <= max_cuts - 2 && amplitude > 1e-7f && fabsf(value - v(2)) <= amplitude + 1e-6f) {
+			const float phase = atan2f(v(1), v(0));
+			const float delta = acosf(math::constrain((value - v(2)) / amplitude, -1.f, 1.f));
+			cuts[count++] = fmodf(phase + delta + turn, turn);
+			cuts[count++] = fmodf(phase - delta + turn, turn);
+		}
+	};
+	roots(sr, sinf(roll_min));
+	roots(sr, sinf(roll_max));
+	roots(sp * cosf(pitch_min) - cp * sinf(pitch_min), 0.f);
+	roots(sp * cosf(pitch_max) - cp * sinf(pitch_max), 0.f);
+	for (unsigned i = 1; i < count; ++i) {
+		const float cut = cuts[i];
+		unsigned j = i;
+
+		while (j > 0 && cut < cuts[j - 1]) {
+			cuts[j] = cuts[j - 1];
+			--j;
+		}
+
+		cuts[j] = cut;
+	}
+
+	float best = INFINITY;
+	const auto evaluate = [&](float heading) {
+		const matrix::Vector3f hc(cosf(heading), sinf(heading), 1.f);
+		const float r = asinf(math::constrain(sr.dot(hc), -1.f, 1.f));
+		const float p = atan2f(sp.dot(hc), cp.dot(hc));
+
+		if (r < roll_min - 1e-6f || r > roll_max + 1e-6f || p < pitch_min - 1e-6f || p > pitch_max + 1e-6f) {
+			return INFINITY;
+		}
+
+		const auto relative = body.transpose() * zxy(0.f, 0.f, heading) * desired;
+		const float y = nearestTurnWithin(atan2f(-relative(0, 1), relative(1, 1)), previous(2), yaw_min, yaw_max);
+		const matrix::Vector3f candidate(math::constrain(r, roll_min, roll_max),
+						 math::constrain(p, pitch_min, pitch_max), y);
+		const float travel = (candidate - previous).norm_squared();
+
+		if (travel < best) {
+			best = travel;
+			joint = candidate;
+		}
+
+		return travel;
+	};
+
+	for (unsigned i = 0; i < count; ++i) {
+		evaluate(cuts[i]);
+
+		if (i + 1 < count && PX4_ISFINITE(evaluate((cuts[i] + cuts[i + 1]) / 2.f))) {
+			float lo = cuts[i];
+			float hi = cuts[i + 1];
+
+			for (unsigned j = 0; j < 14; ++j) {
+				const float left = (2.f * lo + hi) / 3.f;
+				const float right = (lo + 2.f * hi) / 3.f;
+				const float left_travel = evaluate(left);
+				const float right_travel = evaluate(right);
+
+				if (left_travel < right_travel) { hi = right; }
+				else { lo = left; }
+			}
+		}
+	}
+
+	return PX4_ISFINITE(best);
+}
+}
