+void GZGimbal::publishStabilizedPose(hrt_abstime now)
+{
+	const float dt = math::constrain(static_cast<float>(now - _last_pose_update) / 1e6f, 0.f, 0.05f);
+	_last_pose_update = now;
+	const auto flags = _gimbal_device_flags;
+	matrix::Dcmf relative(_pose_target);
+	matrix::Dcmf body;
+	matrix::Dcmf solve_body;
+	matrix::Dcmf desired;
+	const bool compensated = (flags & (RollLock | PitchLock)) || earthYaw(flags);
+
+	if (compensated) {
+		_attitude_sub.update(&_body_attitude);
+		matrix::Quatf q_body(_body_attitude.q);
+		const float norm = q_body.norm();
+
+		if (!_body_attitude.timestamp || now < _body_attitude.timestamp
+		    || now - _body_attitude.timestamp > 200_ms || !PX4_ISFINITE(norm) || norm < 1e-6f) {
+			if (!_invalid_attitude) {
+				PX4_WARN("C11 vehicle attitude unavailable; holding joints");
+			}
+
+			_invalid_attitude = true;
+			publishHorizonStatus(now, true);
+			return;
+		}
+
+		_invalid_attitude = false;
+		q_body.normalize();
+		body = matrix::Dcmf(q_body); // FRD body -> NED earth
+
+		if (hypotf(body(0, 0), body(1, 0)) >= 1e-3f) {
+			_heading = atan2f(body(1, 0), body(0, 0));
+		}
+
+		// Preserve the full quaternion for earth pose, including vertical
+		// camera pitch where ZYX heading and roll are ambiguous.
+		if ((flags & RollLock) && (flags & PitchLock)) {
+			if (!earthYaw(flags)) {
+				relative = matrix::Dcmf(matrix::Eulerf(0.f, 0.f, _heading)) * relative;
+			}
+
+		} else {
+			const matrix::Eulerf requested(_pose_target);
+			const matrix::Eulerf followed(q_body * _pose_target);
+			relative = matrix::Dcmf(matrix::Eulerf((flags & RollLock) ? requested.phi() : followed.phi(),
+							(flags & PitchLock) ? requested.theta() : followed.theta(),
+							earthYaw(flags) ? requested.psi() : _heading + requested.psi()));
+		}
+
+		desired = relative;
+		solve_body = body;
+
+		if ((flags & RollLock) && (flags & PitchLock) && !earthYaw(flags)
+		    && now - _body_attitude.timestamp <= RateMaxAge) {
+			_angular_velocity_sub.update(&_body_rate);
+			solve_body = previewBody(q_body, _body_rate, now);
+		}
+
+		relative = solve_body.transpose() * desired;
+	}
+
+	const float pitch_min = math::radians(_mnt_min_pitch);
+	const float pitch_max = math::radians(_mnt_max_pitch);
+	const matrix::Vector3f previous(_last_roll_stp, _last_pitch_stp, _last_yaw_stp);
+	// _yaw_min/_yaw_max are NAN (infinite yaw) in the bridge, but the C11 Gazebo yaw joint stops at +-2*pi.
+	const float yaw_min = PX4_ISFINITE(_yaw_min) ? _yaw_min : -2.f * M_PI_F;
+	const float yaw_max = PX4_ISFINITE(_yaw_max) ? _yaw_max : 2.f * M_PI_F;
+	bool exact = false;
+	auto joint = boundedJoints(relative, previous, _roll_min, _roll_max, pitch_min, pitch_max, yaw_min, yaw_max, exact);
+	const bool lock_follow = (flags & RollLock) && (flags & PitchLock) && !earthYaw(flags);
+	const auto turn_jump = [&previous](const matrix::Vector3f &candidate) {
+		return fabsf(candidate(2) - nearestTurn(candidate(2), previous(2))) > 1e-3f;
+	};
+
+	if (!exact && lock_follow) {
+		horizonJoints(solve_body, desired, previous, _roll_min, _roll_max, pitch_min, pitch_max, yaw_min, yaw_max,
+			      joint);
+
+	} else if (lock_follow && turn_jump(joint)) {
+		// The exact pose is only reachable by a full yaw turn through the +-2*pi stop window.
+		// Off vertical (FW->MC back-transition after wound FW tracking) that turn sweeps the
+		// camera through the horizon, so keep a continuous horizon solution while one exists.
+		matrix::Vector3f continuous = joint;
+
+		if (horizonJoints(solve_body, desired, previous, _roll_min, _roll_max, pitch_min, pitch_max, yaw_min, yaw_max,
+				  continuous) && !turn_jump(continuous)) {
+			joint = continuous;
+		}
+	}
+	const float step = M_PI_F * dt;
+	const auto slew = [step](float value, float last_value) {
+		return math::constrain(value, last_value - step, last_value + step);
+	};
+	// Retain the nearest yaw winding that stays inside the joint's +-2*pi stops.
+	publishJointCommand(_gimbal_roll_cmd_publisher, slew(joint(0), _last_roll_stp), NAN,
+			    _last_roll_stp, _roll_min, _roll_max, dt);
+	publishJointCommand(_gimbal_pitch_cmd_publisher, slew(joint(1), _last_pitch_stp), NAN,
+			    _last_pitch_stp, pitch_min, pitch_max, dt);
+	publishJointCommand(_gimbal_yaw_cmd_publisher, slew(joint(2), _last_yaw_stp), NAN,
+			    _last_yaw_stp, _yaw_min, _yaw_max, dt);
+
+	if (compensated) {
+		const matrix::Eulerf target(desired);
+		const matrix::Dcmf world(solve_body * zxy(_last_roll_stp, _last_pitch_stp, _last_yaw_stp));
+		const matrix::Eulerf issued(world);
+		// Command residual at the solve epoch; frame acceptance uses measured joints.
+		const bool degraded = fabsf(remainderf(target.phi() - issued.phi(), 2.f * M_PI_F)) > 1e-4f
+				      || fabsf(target.theta() - issued.theta()) > 1e-4f;
+		publishHorizonStatus(now, degraded);
+
+	} else {
+		publishHorizonStatus(now, (joint - matrix::Vector3f(_last_roll_stp, _last_pitch_stp,
+					   _last_yaw_stp)).norm_squared() > 1e-8f || !exact);
+	}
+}
+
+void GZGimbal::publishHorizonStatus(hrt_abstime now, bool degraded)
+{
+	debug_key_value_s status{};
+	status.timestamp = now;
+	std::memcpy(status.key, "c11_hdeg", sizeof("c11_hdeg"));
+	status.value = degraded ? 1.f : 0.f;
+	_horizon_status_pub.publish(status);
+}
