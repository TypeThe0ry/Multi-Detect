{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multidetect.local/schemas/pixhawk-covariance-field-campaign.schema.json",
  "title": "Multi-Detect Pixhawk Covariance Field Campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "release_label", "entries"],
  "properties": {
    "schema": {"const": "multidetect.pixhawk-covariance-field-campaign/v1"},
    "schema_version": {"const": 1},
    "release_label": {"const": "0.3.0-pre.8"},
    "entries": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "nonEmptyPath": {"type": "string", "minLength": 1},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_mode",
        "vehicle_class",
        "endpoint",
        "baud",
        "mission_path",
        "mission_feedback_path",
        "runtime_profile_path",
        "report_path"
      ],
      "properties": {
        "runtime_mode": {"enum": ["hil", "real"]},
        "vehicle_class": {"enum": ["fixed-wing", "multirotor", "vtol"]},
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^(?:udp|udpin|udpout):.*:14550(?:$|[^0-9])"
          }
        },
        "baud": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "mission_path": {"$ref": "#/$defs/nonEmptyPath"},
        "mission_feedback_path": {"$ref": "#/$defs/nonEmptyPath"},
        "runtime_profile_path": {"$ref": "#/$defs/nonEmptyPath"},
        "report_path": {"$ref": "#/$defs/nonEmptyPath"}
      }
    }
  }
}
