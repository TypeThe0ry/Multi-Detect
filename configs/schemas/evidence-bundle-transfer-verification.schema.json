{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-detect.local/schemas/evidence-bundle-transfer-verification.schema.json",
  "title": "Multi-Detect Evidence Bundle Transfer Verification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event", "schema_version", "bundle_id", "verified_at_utc", "source_inventory",
    "destination_root_name", "file_count", "total_bytes", "destination_files",
    "source_bundle_content_hash", "destination_bundle_content_hash", "byte_exact_copy",
    "claims", "canonical_hash"
  ],
  "properties": {
    "event": { "const": "evidence_bundle_transfer_verified" },
    "schema_version": { "const": 1 },
    "bundle_id": { "type": "string", "format": "uuid" },
    "verified_at_utc": { "type": "string", "format": "date-time" },
    "source_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "file_bytes", "file_sha256", "canonical_hash"],
      "properties": {
        "file_name": { "type": "string", "minLength": 1 },
        "file_bytes": { "type": "integer", "minimum": 1 },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "canonical_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "destination_root_name": { "type": "string", "minLength": 1 },
    "file_count": { "type": "integer", "minimum": 1 },
    "total_bytes": { "type": "integer", "minimum": 0 },
    "destination_files": { "$ref": "#/$defs/files" },
    "source_bundle_content_hash": { "$ref": "#/$defs/sha256" },
    "destination_bundle_content_hash": { "$ref": "#/$defs/sha256" },
    "byte_exact_copy": { "const": true },
    "claims": { "$ref": "#/$defs/claims" },
    "canonical_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/portablePath" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardware_acceptance", "release_ready"],
      "properties": {
        "hardware_acceptance": { "const": false },
        "release_ready": { "const": false }
      }
    }
  }
}
