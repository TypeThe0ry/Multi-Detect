{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-detect.local/schemas/evidence-bundle-transfer-inventory.schema.json",
  "title": "Multi-Detect Evidence Bundle Transfer Inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event", "schema_version", "bundle_id", "created_at_utc", "source_root_name",
    "inventory_path", "file_count", "total_bytes", "files", "bundle_content_hash",
    "claims", "canonical_hash"
  ],
  "properties": {
    "event": { "const": "evidence_bundle_transfer_inventory_created" },
    "schema_version": { "const": 1 },
    "bundle_id": { "type": "string", "format": "uuid" },
    "created_at_utc": { "type": "string", "format": "date-time" },
    "source_root_name": { "type": "string", "minLength": 1 },
    "inventory_path": {
      "oneOf": [
        { "$ref": "#/$defs/portablePath" },
        { "type": "null" }
      ]
    },
    "file_count": { "type": "integer", "minimum": 1 },
    "total_bytes": { "type": "integer", "minimum": 0 },
    "files": { "$ref": "#/$defs/files" },
    "bundle_content_hash": { "$ref": "#/$defs/sha256" },
    "claims": { "$ref": "#/$defs/claims" },
    "canonical_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/portablePath" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardware_acceptance", "release_ready"],
      "properties": {
        "hardware_acceptance": { "const": false },
        "release_ready": { "const": false }
      }
    }
  }
}
