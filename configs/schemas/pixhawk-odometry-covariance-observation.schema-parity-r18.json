        "os_sw_version": {
          "$ref": "#/$defs/nullable_nonnegative_integer"
        },
        "board_version": {
          "$ref": "#/$defs/nullable_nonnegative_integer"
        },
        "flight_custom_version_hex": {
          "$ref": "#/$defs/nullable_string"
        },
        "middleware_custom_version_hex": {
          "$ref": "#/$defs/nullable_string"
        },
        "os_custom_version_hex": {
          "$ref": "#/$defs/nullable_string"
        },
        "vendor_id": {
          "$ref": "#/$defs/nullable_nonnegative_integer"
        },
        "product_id": {
