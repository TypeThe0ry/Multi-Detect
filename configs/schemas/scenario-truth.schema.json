{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multidetect.local/schemas/scenario-truth.schema.json",
  "title": "Multi-Detect ScenarioTruth channel v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "scenario_version", "targets"],
  "properties": {
    "schema_version": {"const": 1},
    "scenario_id": {"type": "string", "minLength": 1},
    "scenario_version": {"type": "integer", "minimum": 1},
    "targets": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["target_id", "label", "position", "behavior"], "properties": {"target_id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}, "class": {"type": "string", "minLength": 1}, "color": {"type": "string", "minLength": 1}, "pose": {"type": "object", "additionalProperties": false, "required": ["x_east_m", "y_north_m", "z_up_m", "yaw_rad"], "properties": {"x_east_m": {"type": "number"}, "y_north_m": {"type": "number"}, "z_up_m": {"type": "number"}, "yaw_rad": {"type": "number"}}}, "behavior": {"type": "string", "minLength": 1}, "position": {"type": "object", "additionalProperties": false, "required": ["latitude_deg", "longitude_deg"], "properties": {"latitude_deg": {"type": "number", "minimum": -90, "maximum": 90}, "longitude_deg": {"type": "number", "minimum": -180, "maximum": 180}, "altitude_m": {"type": "number"}, "altitude_reference": {"type": "string", "minLength": 1}}, "dependentRequired": {"altitude_m": ["altitude_reference"], "altitude_reference": ["altitude_m"]}}}}}
  }
}
