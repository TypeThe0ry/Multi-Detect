{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multidetect.local/schemas/autonomy-mission-compile-runtime.schema.json",
  "title": "Multi-Detect MissionCompileRuntime v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "home_position", "mission_geometry", "safety_policy"],
  "properties": {
    "schema_version": {"const": 1},
    "vehicle_class": {"enum": ["vtol", "fixed-wing", "multirotor"]},
    "home_position": {"$ref": "#/$defs/geo_point"},
    "mission_geometry": {
      "anyOf": [
        {"$ref": "#/$defs/hover_geometry"},
        {"$ref": "#/$defs/fixed_wing_geometry"}
      ]
    },
    "safety_policy": {
      "anyOf": [
        {"$ref": "#/$defs/hover_policy"},
        {"$ref": "#/$defs/fixed_wing_policy"}
      ]
    }
  },
  "$defs": {
    "geo_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude_deg", "longitude_deg"],
      "properties": {
        "latitude_deg": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude_deg": {"type": "number", "minimum": -180, "maximum": 180},
        "altitude_m": {"type": "number"},
        "altitude_reference": {"type": "string", "minLength": 1}
      },
      "dependentRequired": {
        "altitude_m": ["altitude_reference"],
        "altitude_reference": ["altitude_m"]
      }
    },
    "relative_point": {
      "allOf": [
        {"$ref": "#/$defs/geo_point"},
        {
          "required": ["altitude_m", "altitude_reference"],
          "properties": {"altitude_reference": {"const": "relative_home"}}
        }
      ]
    },
    "point_array": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/relative_point"}
    },
    "hover_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waypoints",
        "takeoff_altitude_m",
        "loiter_time_s",
        "loiter_radius_m",
        "acceptance_radius_m"
      ],
      "properties": {
        "waypoints": {"$ref": "#/$defs/point_array"},
        "takeoff_altitude_m": {"type": "number", "exclusiveMinimum": 0},
        "loiter_time_s": {"type": "number", "exclusiveMinimum": 0},
        "loiter_radius_m": {"type": "number", "exclusiveMinimum": 0},
        "acceptance_radius_m": {"type": "number", "exclusiveMinimum": 0},
        "landing": {"$ref": "#/$defs/relative_point"}
      }
    },
    "fixed_wing_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waypoints",
        "landing_approach",
        "landing",
        "takeoff_altitude_m",
        "acceptance_radius_m"
      ],
      "properties": {
        "waypoints": {"$ref": "#/$defs/point_array"},
        "landing_approach": {"$ref": "#/$defs/relative_point"},
        "landing": {"$ref": "#/$defs/relative_point"},
        "takeoff_altitude_m": {"type": "number", "exclusiveMinimum": 0},
        "acceptance_radius_m": {"type": "number", "exclusiveMinimum": 0},
        "takeoff_pitch_deg": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
        "takeoff_heading_deg": {"type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360},
        "landing_heading_deg": {"type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360}
      }
    },
    "hover_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geofence_center", "geofence_radius_m", "allowed_airframe_profile_ids"],
      "properties": {
        "geofence_center": {"$ref": "#/$defs/geo_point"},
        "geofence_radius_m": {"type": "number", "exclusiveMinimum": 0},
        "allowed_airframe_profile_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "minimum_relative_altitude_m": {"type": "number", "exclusiveMinimum": 0},
        "maximum_relative_altitude_m": {"type": "number", "exclusiveMinimum": 0},
        "maximum_mission_radius_m": {"type": "number", "exclusiveMinimum": 0},
        "maximum_loiter_radius_m": {"type": "number", "exclusiveMinimum": 0},
        "maximum_loiter_time_s": {"type": "number", "exclusiveMinimum": 0},
        "maximum_landing_offset_m": {"type": "number", "exclusiveMinimum": 0},
        "home_match_tolerance_m": {"type": "number", "exclusiveMinimum": 0},
        "maximum_items": {"type": "integer", "minimum": 6}
      }
    },
    "fixed_wing_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geofence_center", "geofence_radius_m", "allowed_airframe_profile_ids"],
      "properties": {
        "geofence_center": {"$ref": "#/$defs/geo_point"},
        "geofence_radius_m": {"type": "number", "exclusiveMinimum": 0},
        "allowed_airframe_profile_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "minimum_relative_altitude_m": {"type": "number", "exclusiveMinimum": 0},
        "maximum_relative_altitude_m": {"type": "number", "exclusiveMinimum": 0},
        "maximum_mission_radius_m": {"type": "number", "exclusiveMinimum": 0},
        "minimum_turn_radius_m": {"type": "number", "exclusiveMinimum": 0},
        "minimum_leg_length_m": {"type": "number", "exclusiveMinimum": 0},
        "minimum_landing_approach_m": {"type": "number", "exclusiveMinimum": 0},
        "maximum_landing_approach_m": {"type": "number", "exclusiveMinimum": 0},
        "maximum_glide_slope_deg": {"type": "number", "minimum": 0},
        "maximum_landing_offset_m": {"type": "number", "minimum": 0},
        "maximum_landing_alignment_deg": {"type": "number", "minimum": 0, "maximum": 90},
        "home_match_tolerance_m": {"type": "number", "exclusiveMinimum": 0},
        "cruise_airspeed_mps": {"type": "number", "exclusiveMinimum": 0},
        "minimum_airspeed_mps": {"type": "number", "exclusiveMinimum": 0},
        "maximum_tailwind_mps": {"type": "number", "minimum": 0},
        "maximum_crosswind_mps": {"type": "number", "minimum": 0},
        "maximum_gps_accuracy_m": {"type": "number", "minimum": 0},
        "minimum_battery_reserve_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "reserve_time_s": {"type": "number", "exclusiveMinimum": 0},
        "maximum_items": {"type": "integer", "minimum": 4},
        "maximum_corner_angle_deg": {"type": "number", "minimum": 1, "exclusiveMaximum": 180}
      }
    }
  }
}
