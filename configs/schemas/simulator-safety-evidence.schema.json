{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multidetect.local/schemas/simulator-safety-evidence.schema.json",
  "title": "Multi-Detect deterministic SIM safety evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event",
    "runtime_mode",
    "release_label",
    "gate_passed",
    "truth_free",
    "checks",
    "cancel",
    "control",
    "geolocation",
    "mission",
    "claims"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event": {"const": "simulator_safety_acceptance_finished"},
    "runtime_mode": {"const": "sim"},
    "release_label": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+-pre\\.[1-9]\\d*$"},
    "gate_passed": {"type": "boolean"},
    "truth_free": {"const": true},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancel_clears_target_evidence",
        "unauthorized_control_blocked",
        "geofence_and_false_gps_fail_closed",
        "mission_terminal_consistent",
        "loopback_only",
        "no_control_after_failsafe"
      ],
      "properties": {
        "cancel_clears_target_evidence": {"const": true},
        "unauthorized_control_blocked": {"const": true},
        "geofence_and_false_gps_fail_closed": {"const": true},
        "mission_terminal_consistent": {"const": true},
        "loopback_only": {"const": true},
        "no_control_after_failsafe": {"const": true}
      }
    },
    "cancel": {"$ref": "#/$defs/cancel"},
    "control": {"$ref": "#/$defs/control"},
    "geolocation": {"$ref": "#/$defs/geolocation"},
    "mission": {"$ref": "#/$defs/mission"},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hardware_acceptance",
        "operator_visual_acceptance",
        "pixhawk_jetson_camera_acceptance",
        "real_flight_acceptance",
        "truth_free"
      ],
      "properties": {
        "hardware_acceptance": {"const": "not_claimed"},
        "operator_visual_acceptance": {"const": "not_claimed"},
        "pixhawk_jetson_camera_acceptance": {"const": "not_claimed"},
        "real_flight_acceptance": {"const": "not_claimed"},
        "truth_free": {"const": true}
      }
    }
  },
  "$defs": {
    "idList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_target_ids", "lck_target_id", "trk_target_ids_after_demote", "trk_target_ids_before_cancel", "single_cancel", "cancel"],
      "properties": {
        "initial_target_ids": {"allOf": [{"$ref": "#/$defs/idList"}, {"minItems": 2}]},
        "lck_target_id": {"type": "string", "minLength": 1},
        "trk_target_ids_after_demote": {"$ref": "#/$defs/idList"},
        "trk_target_ids_before_cancel": {"$ref": "#/$defs/idList"},
        "single_cancel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cancelled_target_id", "remaining_tracked_target_ids", "active_target_id", "clears_only_selected_target"],
          "properties": {
            "cancelled_target_id": {"type": "string", "minLength": 1},
            "remaining_tracked_target_ids": {"$ref": "#/$defs/idList"},
            "active_target_id": {"type": ["string", "null"]},
            "clears_only_selected_target": {"const": true}
          }
        },
        "cancel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cancelled", "active_target_id_after_cancel", "tracked_target_ids_after_cancel", "locked_target_ids_after_cancel", "primary_target_id_after_cancel", "target_evidence_after_cancel", "reacquired_only_after_new_selection", "reacquired_target_id", "before_reselect"],
          "properties": {
            "cancelled": {"const": true},
            "active_target_id_after_cancel": {"type": "null"},
            "tracked_target_ids_after_cancel": {"const": []},
            "locked_target_ids_after_cancel": {"const": []},
            "primary_target_id_after_cancel": {"type": "null"},
            "target_evidence_after_cancel": {"type": "null"},
            "reacquired_only_after_new_selection": {"const": true},
            "reacquired_target_id": {"type": "string", "minLength": 1},
            "before_reselect": {
              "type": "object",
              "additionalProperties": false,
              "required": ["active_target_id", "tracked_target_ids", "locked_target_ids", "primary_target_id", "target_evidence"],
              "properties": {
                "active_target_id": {"type": "null"},
                "tracked_target_ids": {"const": []},
                "locked_target_ids": {"const": []},
                "primary_target_id": {"type": "null"},
                "target_evidence": {"type": "null"}
              }
            }
          }
        }
      }
    },
    "interactiveMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "gate_passed", "loopback_only", "qgc_manual_frames_accepted", "qgc_non_loopback_datagrams_blocked", "qgc_unexpected_source_datagrams_blocked", "qgc_mission_writes_allowed", "qgc_flight_commands_allowed", "qgc_rejected_reasons", "px4_non_loopback_datagrams_blocked", "watchdog_failsafe", "neutral_watchdog_frame"],
      "properties": {
        "mode": {"enum": ["vtol", "fixed-wing", "multirotor"]},
        "gate_passed": {"const": true},
        "loopback_only": {"const": true},
        "qgc_manual_frames_accepted": {"type": "integer", "minimum": 1},
        "qgc_non_loopback_datagrams_blocked": {"type": "integer", "minimum": 1},
        "qgc_unexpected_source_datagrams_blocked": {"type": "integer", "minimum": 1},
        "qgc_mission_writes_allowed": {"const": false},
        "qgc_flight_commands_allowed": {"const": false},
        "qgc_rejected_reasons": {
          "type": "object",
          "additionalProperties": false,
          "required": ["qgc_source_system_mismatch", "manual_control_target_mismatch", "qgc_message_not_allowed", "unexpected_source_port"],
          "properties": {
            "qgc_source_system_mismatch": {"type": "integer", "minimum": 1},
            "manual_control_target_mismatch": {"type": "integer", "minimum": 1},
            "qgc_message_not_allowed": {"type": "integer", "minimum": 1},
            "unexpected_source_port": {"type": "integer", "minimum": 1}
          }
        },
        "px4_non_loopback_datagrams_blocked": {"type": "integer", "minimum": 1},
        "watchdog_failsafe": {"const": true},
        "neutral_watchdog_frame": {"const": true}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interactive_gate_passed", "interactive_modes", "direct_watchdog", "loopback_only", "unauthorized_control_acceptances"],
      "properties": {
        "interactive_gate_passed": {"const": true},
        "interactive_modes": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/interactiveMode"}, "uniqueItems": true},
        "direct_watchdog": {"$ref": "#/$defs/directWatchdog"},
        "loopback_only": {"const": true},
        "unauthorized_control_acceptances": {"const": 0}
      }
    },
    "directWatchdog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai_control_accepted_before_watchdog", "messages_before_watchdog", "watchdog_neutral_emitted", "messages_after_watchdog", "authority_state_after_watchdog", "authority_last_setpoint_after_watchdog", "ai_attempt_after_failsafe_rejected", "ai_rejection_reason", "messages_after_rejected_ai", "no_control_after_failsafe", "last_receipt_source", "last_frame", "non_loopback_endpoint_rejected", "loopback_endpoint"],
      "properties": {
        "ai_control_accepted_before_watchdog": {"const": true},
        "messages_before_watchdog": {"type": "integer", "minimum": 1},
        "watchdog_neutral_emitted": {"const": true},
        "messages_after_watchdog": {"type": "integer", "minimum": 2},
        "authority_state_after_watchdog": {"const": "failsafe"},
        "authority_last_setpoint_after_watchdog": {"type": "null"},
        "ai_attempt_after_failsafe_rejected": {"const": true},
        "ai_rejection_reason": {"type": "string", "minLength": 1},
        "messages_after_rejected_ai": {"type": "integer", "minimum": 2},
        "no_control_after_failsafe": {"const": true},
        "last_receipt_source": {"const": "watchdog"},
        "last_frame": {"const": [0, 0, 500, 0, 0, 0]},
        "non_loopback_endpoint_rejected": {"const": true},
        "loopback_endpoint": {"pattern": "^udpout:(127\\.0\\.0\\.1|\\[::1\\]|::1):[0-9]+$", "type": "string"}
      }
    },
    "geolocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe_decision_allowed", "safety_denial_cases", "accepted_count", "denied_count", "false_geolocations", "accepted_coordinates", "geolocation_denials"],
      "properties": {
        "safe_decision_allowed": {"const": true},
        "safety_denial_cases": {"type": "array", "minItems": 3, "maxItems": 3},
        "accepted_count": {"const": 1},
        "denied_count": {"type": "integer", "minimum": 2},
        "false_geolocations": {"const": 0},
        "accepted_coordinates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latitude_deg", "longitude_deg", "horizontal_sigma_m"],
          "properties": {
            "latitude_deg": {"type": "number", "exclusiveMinimum": -90, "exclusiveMaximum": 90},
            "longitude_deg": {"type": "number", "minimum": -180, "maximum": 180},
            "horizontal_sigma_m": {"type": "number", "minimum": 0}
          }
        },
        "geolocation_denials": {"type": "array", "minItems": 2}
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_state", "allowed_terminal_states", "history", "terminal_event_last", "post_terminal_events", "post_terminal_rejections", "post_terminal_commands_accepted", "transition_count"],
      "properties": {
        "terminal_state": {"const": "terminated"},
        "allowed_terminal_states": {"$ref": "#/$defs/idList"},
        "history": {"type": "array", "minItems": 1},
        "terminal_event_last": {"const": true},
        "post_terminal_events": {"$ref": "#/$defs/idList"},
        "post_terminal_rejections": {"type": "integer", "minimum": 1},
        "post_terminal_commands_accepted": {"const": 0},
        "transition_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
