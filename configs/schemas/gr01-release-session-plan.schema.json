{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-detect.local/schemas/gr01-release-session-plan.schema.json",
  "title": "Multi-Detect GR01 release session plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "generated_at_utc",
    "host_address",
    "port",
    "hardware_id",
    "expected_source_cidr",
    "secret_environment",
    "thresholds",
    "paths",
    "source_identity",
    "operations",
    "ready_to_execute",
    "reasons",
    "claims"
  ],
  "properties": {
    "schema": {"const": "multidetect.gr01-release-session-plan/v2"},
    "schema_version": {"const": 2},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "host_address": {"type": "string", "format": "ipv4", "not": {"const": "127.0.0.1"}},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "hardware_id": {"type": "string", "minLength": 1},
    "expected_source_cidr": {"type": "string", "minLength": 1},
    "secret_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator_hmac", "mavlink_signing"],
      "properties": {
        "operator_hmac": {"$ref": "#/$defs/secret"},
        "mavlink_signing": {"$ref": "#/$defs/secret"}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_round_trips",
        "maximum_packet_loss_rate",
        "maximum_ack_latency_p95_ms",
        "maximum_attempts",
        "maximum_evidence_age_s"
      ],
      "properties": {
        "minimum_round_trips": {"type": "integer", "minimum": 1},
        "maximum_packet_loss_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_ack_latency_p95_ms": {"type": "number", "exclusiveMinimum": 0},
        "maximum_attempts": {"type": "integer", "minimum": 1},
        "maximum_evidence_age_s": {"type": "number", "minimum": 0}
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_root", "python", "output_root"],
      "properties": {
        "repository_root": {"type": "string", "minLength": 1},
        "python": {"type": "string", "minLength": 1},
        "output_root": {"type": "string", "minLength": 1}
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "release_parity", "tools"],
      "properties": {
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "git_head", "tracked_dirty"],
          "properties": {
            "root": {"type": "string", "minLength": 1},
            "git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "tracked_dirty": {"type": "boolean"}
          }
        },
        "release_parity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "bytes",
            "release_label",
            "safety_policy_hash",
            "source_verified"
          ],
          "properties": {
            "path": {"const": "configs/release-parity.json"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "bytes": {"type": "integer", "minimum": 1},
            "release_label": {"type": "string", "pattern": "^0\\.3\\.0-pre\\.[0-9]+$"},
            "safety_policy_hash": {"$ref": "#/$defs/sha256"},
            "source_verified": {"type": "boolean"}
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scripts_run_gr01_release_session_ps1",
            "scripts_run_multidetect_cli_py",
            "scripts_verify_gr01_release_session_plan_py",
            "src_multidetect_gr01_release_plan_py"
          ],
          "properties": {
            "scripts_run_gr01_release_session_ps1": {"$ref": "#/$defs/file"},
            "scripts_run_multidetect_cli_py": {"$ref": "#/$defs/file"},
            "scripts_verify_gr01_release_session_plan_py": {"$ref": "#/$defs/file"},
            "src_multidetect_gr01_release_plan_py": {"$ref": "#/$defs/file"}
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "prefixItems": [
        {"const": "gr01_hardware_bench"},
        {"const": "independent_bench_verification"},
        {"const": "freshness_bound_e7_evaluation"},
        {"const": "independent_release_session_verification"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "ready_to_execute": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_contacted",
        "hardware_observed",
        "hardware_flight_acceptance",
        "physical_release_enabled",
        "flight_control_enabled",
        "payload_release_requested"
      ],
      "properties": {
        "network_contacted": {"const": false},
        "hardware_observed": {"const": false},
        "hardware_flight_acceptance": {"const": "not_claimed"},
        "physical_release_enabled": {"const": false},
        "flight_control_enabled": {"const": false},
        "payload_release_requested": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "present"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "present": {"type": "boolean"}
      }
    }
  }
}
