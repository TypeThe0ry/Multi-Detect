{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-detect.local/schemas/gr01-release-session-source-attestation.schema.json",
  "title": "Multi-Detect GR01 source inventory attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event", "schema_version", "attested_at_utc", "bundle_id", "operator",
    "inventory", "claims", "signature", "canonical_hash"
  ],
  "properties": {
    "event": {"const": "multidetect_gr01_release_session_source_attested"},
    "schema_version": {"const": 1},
    "attested_at_utc": {"type": "string", "format": "date-time"},
    "bundle_id": {"type": "string", "format": "uuid"},
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "key_id", "public_key_ed25519_hex"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "key_id": {"type": "string", "minLength": 1},
        "public_key_ed25519_hex": {"$ref": "#/$defs/hex32"}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "file_bytes", "file_sha256", "canonical_hash", "bundle_content_hash"],
      "properties": {
        "name": {"const": "gr01-release-session-transfer-inventory.json"},
        "file_bytes": {"type": "integer", "minimum": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_hash": {"$ref": "#/$defs/sha256"},
        "bundle_content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_integrity_attested", "operator_key_possession_verified",
        "operator_human_identity_verified", "attestation_network_contacted",
        "hardware_flight_acceptance", "physical_release_enabled",
        "flight_control_enabled", "payload_release_requested"
      ],
      "properties": {
        "inventory_integrity_attested": {"const": true},
        "operator_key_possession_verified": {"const": true},
        "operator_human_identity_verified": {"const": false},
        "attestation_network_contacted": {"const": false},
        "hardware_flight_acceptance": {"const": "not_claimed"},
        "physical_release_enabled": {"const": false},
        "flight_control_enabled": {"const": false},
        "payload_release_requested": {"const": false}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "signed_payload_sha256", "signature_ed25519_hex"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "signed_payload_sha256": {"$ref": "#/$defs/sha256"},
        "signature_ed25519_hex": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
      }
    },
    "canonical_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hex32": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
