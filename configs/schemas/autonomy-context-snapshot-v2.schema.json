{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multidetect.local/schemas/autonomy-context-snapshot-v2.schema.json",
  "title": "Multi-Detect ContextSnapshot v2 explicit missing observations",
  "description": "Identity-bound source declarations are not authentication or flight authority. Application parsing also requires finite numbers and exact capability scope bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "snapshot_id", "captured_at_s", "captured_at_utc",
    "aircraft_position", "home_position", "airframe_profile_id",
    "battery_remaining_pct", "estimated_flight_time_s", "ground_speed_mps",
    "airspeed_mps", "wind_north_mps", "wind_east_mps", "gps_fix_type",
    "gps_horizontal_accuracy_m", "geofence_valid", "camera_available",
    "perception_available", "map_cache_available", "dem_available",
    "provenance", "flight_capability"
  ],
  "properties": {
    "schema_version": {"const": 2, "type": "integer"},
    "snapshot_id": {"$ref": "#/$defs/text"},
    "captured_at_s": {"type": "number", "minimum": 0},
    "captured_at_utc": {"type": "string", "format": "date-time"},
    "aircraft_position": {"$ref": "#/$defs/geo_point"},
    "home_position": {"$ref": "#/$defs/geo_point"},
    "airframe_profile_id": {"$ref": "#/$defs/text"},
    "airframe_profile_hash": {"$ref": "#/$defs/sha256"},
    "battery_remaining_pct": {"type": "number", "minimum": 0, "maximum": 100},
    "estimated_flight_time_s": {"type": ["number", "null"], "minimum": 0},
    "ground_speed_mps": {"type": "number", "minimum": 0},
    "airspeed_mps": {"type": ["number", "null"], "minimum": 0},
    "wind_north_mps": {"type": ["number", "null"]},
    "wind_east_mps": {"type": ["number", "null"]},
    "gps_fix_type": {"type": "integer", "minimum": 0, "maximum": 8},
    "gps_horizontal_accuracy_m": {"type": "number", "minimum": 0},
    "geofence_valid": {"type": "boolean"},
    "camera_available": {"type": "boolean"},
    "perception_available": {"type": "boolean"},
    "map_cache_available": {"type": "boolean"},
    "dem_available": {"type": "boolean"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "flight_capability": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/flight_capability"}]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"provenance": {"properties": {"airspeed": {"properties": {"kind": {"const": "unknown"}}}}}}},
      "then": {"properties": {"airspeed_mps": {"type": "null"}}},
      "else": {"properties": {"airspeed_mps": {"type": "number"}}}
    },
    {
      "if": {"properties": {"provenance": {"properties": {"endurance": {"properties": {"kind": {"const": "unknown"}}}}}}},
      "then": {"properties": {"estimated_flight_time_s": {"type": "null"}}},
      "else": {"properties": {"estimated_flight_time_s": {"type": "number"}}}
    },
    {
      "if": {"properties": {"provenance": {"properties": {"wind": {"properties": {"kind": {"const": "unknown"}}}}}}},
      "then": {"properties": {"wind_north_mps": {"type": "null"}, "wind_east_mps": {"type": "null"}}},
      "else": {"properties": {"wind_north_mps": {"type": "number"}, "wind_east_mps": {"type": "number"}}}
    }
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "runtime_kind": {"enum": ["SIM", "HIL", "REAL", "REPLAY"]},
    "geo_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude_deg", "longitude_deg"],
      "properties": {
        "latitude_deg": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude_deg": {"type": "number", "minimum": -180, "maximum": 180},
        "altitude_m": {"type": "number"},
        "altitude_reference": {"$ref": "#/$defs/text"}
      },
      "dependentRequired": {
        "altitude_m": ["altitude_reference"],
        "altitude_reference": ["altitude_m"]
      }
    },
    "value_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "evidence_sha256"],
      "properties": {
        "kind": {"$ref": "#/$defs/text"},
        "evidence_sha256": {"type": ["string", "null"]}
      },
      "if": {"properties": {"kind": {"const": "unknown"}}},
      "then": {"properties": {"evidence_sha256": {"type": "null"}}},
      "else": {"properties": {"evidence_sha256": {"$ref": "#/$defs/sha256"}}}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_kind", "airspeed", "endurance", "wind"],
      "properties": {
        "runtime_kind": {"$ref": "#/$defs/runtime_kind"},
        "airspeed": {
          "allOf": [
            {"$ref": "#/$defs/value_source"},
            {"properties": {"kind": {"enum": ["unknown", "air_relative_sensor", "air_relative_estimator"]}}}
          ]
        },
        "endurance": {
          "allOf": [
            {"$ref": "#/$defs/value_source"},
            {"properties": {"kind": {"enum": ["unknown", "autopilot_reported", "explicit_SIM_energy_model"]}}}
          ]
        },
        "wind": {
          "allOf": [
            {"$ref": "#/$defs/value_source"},
            {"properties": {"kind": {"enum": ["unknown", "observed_wind_estimate", "explicit_SIM_wind_model"]}}}
          ]
        }
      }
    },
    "flight_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["airframe_profile_id", "airframe_profile_hash", "vehicle_class", "runtime_kind", "cruise_airspeed_mps", "model_sha256"],
      "properties": {
        "airframe_profile_id": {"$ref": "#/$defs/text"},
        "airframe_profile_hash": {"$ref": "#/$defs/sha256"},
        "vehicle_class": {"enum": ["multirotor", "fixed-wing", "vtol"]},
        "runtime_kind": {"$ref": "#/$defs/runtime_kind"},
        "cruise_airspeed_mps": {"type": "number", "exclusiveMinimum": 0},
        "model_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
