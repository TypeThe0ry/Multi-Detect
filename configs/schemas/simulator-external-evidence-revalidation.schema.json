{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multidetect.local/schemas/simulator-external-evidence-revalidation.schema.json",
  "title": "Multi-Detect external SIM join revalidation evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event",
    "generated_at_utc",
    "report_path",
    "report_sha256",
    "report_bytes",
    "source_recomputed",
    "release_label",
    "expected_release_label",
    "gate_passed",
    "reasons"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event": {"const": "simulator_external_runtime_ai_evidence_revalidated"},
    "generated_at_utc": {"type": "string", "minLength": 1},
    "report_path": {"type": "string", "minLength": 1},
    "report_sha256": {"$ref": "#/$defs/sha256"},
    "report_bytes": {"type": "integer", "minimum": 1},
    "source_recomputed": {"type": "boolean"},
    "release_label": {"type": ["string", "null"]},
    "expected_release_label": {"type": ["string", "null"]},
    "gate_passed": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
