{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://multi-detect.local/schemas/alert-link-bench.schema.json",
  "title": "Multi-Detect authenticated alert-link bench report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event",
    "observed_at_utc",
    "hardware_observed",
    "simulation_only",
    "passed",
    "reasons",
    "checks",
    "transport_protocol",
    "remote_host",
    "remote_port",
    "remote_is_loopback",
    "hardware_id",
    "requested_round_trips",
    "round_trip_samples",
    "failed_round_trips",
    "transmission_attempts",
    "missing_ack_attempts",
    "packet_loss_rate",
    "ack_latency_p50_ms",
    "ack_latency_p95_ms",
    "correlated_ack_verified",
    "authenticated_ack_verified",
    "failure_types",
    "thresholds",
    "alert_hardware_control_enabled",
    "flight_control_enabled",
    "physical_release_enabled",
    "payload_release_requested",
    "production_approved",
    "physical_release_approved"
  ],
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"enum": [2, 3, 4]}}},
      "then": {
        "required": [
          "expected_source_cidr",
          "local_source_address",
          "source_route_verified"
        ],
        "properties": {"checks": {"required": ["source_route"]}}
      }
    },
    {
      "if": {"properties": {"schema_version": {"enum": [3, 4]}}},
      "then": {
        "required": [
          "transport_source_address",
          "transport_source_address_bound"
        ],
        "properties": {"checks": {"required": ["transport_source_binding"]}}
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": 4}}},
      "then": {
        "required": [
          "observed_transport_source_addresses",
          "transport_source_observation_count",
          "transport_source_observations_complete"
        ],
        "properties": {"checks": {"required": ["transport_source_observations"]}}
      }
    }
  ],
  "properties": {
    "schema_version": {"enum": [1, 2, 3, 4]},
    "event": {
      "enum": [
        "alert_link_bench_passed",
        "alert_link_bench_failed",
        "alert_link_software_baseline_bench_passed",
        "alert_link_software_baseline_bench_failed"
      ]
    },
    "observed_at_utc": {"type": "string", "minLength": 1},
    "hardware_observed": {"type": "boolean"},
    "simulation_only": {"type": "boolean"},
    "passed": {"type": "boolean"},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_round_trips",
        "packet_loss_limit",
        "ack_latency_limit",
        "mode_boundary",
        "correlated_ack",
        "authenticated_transport"
      ],
      "properties": {
        "required_round_trips": {"type": "boolean"},
        "packet_loss_limit": {"type": "boolean"},
        "ack_latency_limit": {"type": "boolean"},
        "mode_boundary": {"type": "boolean"},
        "source_route": {"type": "boolean"},
        "transport_source_binding": {"type": "boolean"},
        "transport_source_observations": {"type": "boolean"},
        "correlated_ack": {"type": "boolean"},
        "authenticated_transport": {"type": "boolean"}
      }
    },
    "transport_protocol": {"type": "string", "minLength": 1},
    "remote_host": {"type": ["string", "null"]},
    "remote_port": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535},
    "remote_is_loopback": {"type": "boolean"},
    "expected_source_cidr": {"type": ["string", "null"]},
    "local_source_address": {"type": ["string", "null"]},
    "source_route_verified": {"type": "boolean"},
    "transport_source_address": {"type": ["string", "null"]},
    "transport_source_address_bound": {"type": "boolean"},
    "observed_transport_source_addresses": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "transport_source_observation_count": {"type": "integer", "minimum": 0},
    "transport_source_observations_complete": {"type": "boolean"},
    "hardware_id": {"type": ["string", "null"]},
    "requested_round_trips": {"type": "integer", "minimum": 1},
    "round_trip_samples": {"type": "integer", "minimum": 0},
    "failed_round_trips": {"type": "integer", "minimum": 0},
    "transmission_attempts": {"type": "integer", "minimum": 0},
    "missing_ack_attempts": {"type": "integer", "minimum": 0},
    "packet_loss_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "ack_latency_p50_ms": {"type": ["number", "null"], "minimum": 0},
    "ack_latency_p95_ms": {"type": ["number", "null"], "minimum": 0},
    "correlated_ack_verified": {"type": "boolean"},
    "authenticated_ack_verified": {"type": "boolean"},
    "failure_types": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_packet_loss_rate",
        "maximum_ack_latency_p95_ms",
        "maximum_attempts"
      ],
      "properties": {
        "maximum_packet_loss_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_ack_latency_p95_ms": {"type": "number", "exclusiveMinimum": 0},
        "maximum_attempts": {"type": "integer", "minimum": 1}
      }
    },
    "alert_hardware_control_enabled": {"const": false},
    "flight_control_enabled": {"const": false},
    "physical_release_enabled": {"const": false},
    "payload_release_requested": {"const": false},
    "production_approved": {"const": false},
    "physical_release_approved": {"const": false}
  }
}
