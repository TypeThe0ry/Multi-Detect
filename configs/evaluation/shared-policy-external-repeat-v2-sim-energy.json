{
  "schema_version": 1,
  "evaluation_id": "shared-policy-external-repeat-v2-sim-energy",
  "product_version": "0.3.0-pre.8",
  "runtime_mode": "SIM",
  "existing_runs_diagnostic_only": true,
  "metric_status": "post_mission_energy_window_model_ready_requires_repeat_gate",
  "minimum_parent_runs": 3,
  "minimum_candidate_runs": 3,
  "required_invariants": [
    "same_scenario_manifest",
    "same_stable_airframe_profile",
    "same_campaign_identity",
    "same_task_set_for_metric",
    "same_px4_mission_path",
    "all_gate_passed",
    "all_cleanup_clean"
  ],
  "primary_metric": {
    "name": "planning_energy_wh_total",
    "path": "mission_completed.planning_energy.newly_consumed_wh",
    "aggregation": "sum",
    "direction": "minimize",
    "minimum_candidate_margin": 0.1,
    "validity": "post_mission_receive_window_model_only_not_physical_calibration"
  },
  "promotion_policy": {
    "require_metric_present_in_every_run": true,
    "require_minimum_run_counts": true,
    "require_all_invariants": true,
    "candidate_promoted_by_evaluator": false,
    "physical_performance_claimed": false,
    "require_full_mission_energy_window": true
  }
}
