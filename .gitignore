.venv-vlm-navigation/
.venv-gazebo-navigation-20261008-r1/
venv/
dist/
build/
artifacts/
# Some migrated pytest fixtures use a dot-prefixed artifact root.  It is
# ephemeral test output, not release evidence; keep it out of provenance while
# preserving any existing files for inspection.
/.artifacts/

# Local configuration and credentials. Commit only redacted examples.
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
secrets/
credentials/

# Editor and local OS state.
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

/tmp/dataset-audit/
/tmp/pytest-*/
# Local smoke-test captures, benchmark snapshots and ad-hoc probes.
/tmp/
/tmp-*
# Dot-prefixed temporary runs are generated by migrated acceptance and
# calibration harnesses as well (some are directories, some are log files).
# Keep them inspectable on disk while excluding them from Git provenance.
/.tmp-*
# The goal-acceptance runner deliberately keeps pytest bases inside the
# workspace so subprocesses share the same bounded temp volume.  They are
# ephemeral test trees, not source or release evidence; ignore them without
# deleting an existing migration/acceptance directory.
/.tmp-pytest-*/
# Ephemeral multi-process acceptance run directories; durable evidence is
# copied under artifacts/evaluation/ when it is part of the release record.
/runs/
/runs/simulator/

# Qt/QML AOT cache artifacts generated beside custom QML during local builds.
# The source .qml files remain the repository truth; qmlc files are rebuilt.
*.qmlc

/yolo*.pt
models/*.engine
models/*.onnx
models/*.pt
models/*.weights
models/**/*.engine
models/**/*.onnx
models/**/*.plan

# Keep the local multi-gigabyte training corpus out of normal Git operations.
森林火灾 检测 7000多   数据集/

# Unified MultiDetectGCS source tree. Its nested .gitignore carries the full
# QGroundControl toolchain rules; these root rules make the large local-only
# directories explicit to anyone working from the unified repository.
/ground-control/MultiDetectGCS/.git/
/ground-control/MultiDetectGCS/.cache/
/ground-control/MultiDetectGCS/.venv/
/ground-control/MultiDetectGCS/.pytest_cache/
/ground-control/MultiDetectGCS/.ruff_cache/
/ground-control/MultiDetectGCS/.vs/
/ground-control/MultiDetectGCS/.qt/
/ground-control/MultiDetectGCS/build*/
/ground-control/MultiDetectGCS/cmake-build-*/
/ground-control/MultiDetectGCS/file-alias-sandbox/
/ground-control/MultiDetectGCS/staging-*/
/ground-control/MultiDetectGCS/artifacts/
/ground-control/MultiDetectGCS/*.log

# Local caches and ad-hoc logs
/.cache/
/rebind-*.log
/multidetect-sim-acceptance-ai-job/
/.pytest-tmp*/
/.pytest-sim-output.txt
/.pytest-basetemp/

# local gate run output
.onboard-gate-*

# Robustness-suite world variants generated at run time by scripts/augment_sim_world.py
simulation/gazebo/worlds/*__*.sdf
