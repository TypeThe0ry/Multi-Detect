{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spica://tools/target_result.json",
  "title": "TargetResult",
  "description": "Sparse optional fields; projection is checked against TargetQuery.outputs by Python helpers.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "distance_m": {
      "type": "number",
      "minimum": 0
    },
    "bearing_deg": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "alt": {
      "type": "number",
      "description": "WGS84 ellipsoidal height in metres; not AMSL."
    },
    "elevation_m": {
      "type": "number",
      "description": "Height above local ground in metres."
    },
    "cov": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 2,
      "maxItems": 2,
      "description": "Symmetric positive semidefinite horizontal covariance [[NN,NE],[EN,EE]] in local north/east m²."
    },
    "ellipse": {
      "$ref": "spica://tools/common.json#/definitions/ErrorEllipse"
    },
    "cep50": {
      "type": "number",
      "minimum": 0,
      "description": "Circular error probable, metres, probability 0.50."
    },
    "cep95": {
      "type": "number",
      "minimum": 0,
      "description": "Circular error radius, metres, probability 0.95."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "track_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Sample"
      }
    },
    "trajectory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Sample"
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "exists": {
      "type": "boolean"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Sample": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "alt": {
          "type": "number"
        },
        "bearing_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "track_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "timestamp"
      ],
      "additionalProperties": false
    }
  },
  "examples": [
    {},
    {
      "distance_m": 12,
      "bearing_deg": 90,
      "lat": 1.3,
      "lon": 103.8,
      "alt": 15,
      "cov": [
        [
          4,
          1
        ],
        [
          1,
          9
        ]
      ],
      "ellipse": {
        "semi_major_m": 3,
        "semi_minor_m": 2,
        "orientation_deg": 30,
        "confidence": 0.95
      },
      "cep50": 2,
      "cep95": 5,
      "confidence": 0.9,
      "track_id": "car-42",
      "timestamp": "2026-11-15T10:01:00Z"
    }
  ],
  "x-output-fields": {
    "distance": [
      "distance_m"
    ],
    "bearing": [
      "bearing_deg"
    ],
    "wgs84": [
      "lat",
      "lon",
      "alt"
    ],
    "elevation": [
      "elevation_m"
    ],
    "covariance": [
      "cov"
    ],
    "ellipse": [
      "ellipse"
    ],
    "cep50": [
      "cep50"
    ],
    "cep95": [
      "cep95"
    ],
    "confidence": [
      "confidence"
    ],
    "track_id": [
      "track_id"
    ],
    "timestamp": [
      "timestamp"
    ],
    "history": [
      "history"
    ],
    "trajectory": [
      "trajectory"
    ],
    "count": [
      "count"
    ],
    "exists": [
      "exists"
    ]
  }
}
